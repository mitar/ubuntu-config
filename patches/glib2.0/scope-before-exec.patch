+/* How long to wait for the scope at most, and how often to check whether this
+ * process is in it already. Waiting ends as soon as it is, or as soon as the
+ * launching process learnt that it will not be, so the limit only matters when
+ * nothing can tell: when the launching process exited before systemd finished
+ * starting the scope, or never runs its main loop again. Running the
+ * application before systemd moved the process would leave every process the
+ * application started until then outside of the scope, so the limit is long,
+ * and is reached only when systemd did not process a request for a minute. */
+#define SCOPE_TIMEOUT_MS 60000
+#define SCOPE_POLL_MS 1
+
+/*
+ * is_in_unit:
+ * @unit: name of a systemd unit
+ *
+ * Returns: nonzero if this process is in the cgroup of @unit, or in one below
+ *     it, as listed for the unified hierarchy in /proc/self/cgroup
+ */
+static int
+is_in_unit (const char *unit)
+{
+  char buf[4096];
+  char *line;
+  char *line_end;
+  const char *match;
+  size_t unit_len = strlen (unit);
+  ssize_t len = 0;
+  ssize_t r;
+  int fd;
+
+  fd = open ("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return 0;
+
+  do
+    {
+      r = read (fd, buf + len, sizeof (buf) - 1 - (size_t) len);
+      if (r > 0)
+        len += r;
+    }
+  while ((r > 0 && (size_t) len < sizeof (buf) - 1) || (r < 0 && errno == EINTR));
+  close (fd);
+
+  if (r < 0)
+    return 0;
+
+  buf[len] = '\0';
+
+  if (strncmp (buf, "0::", 3) == 0)
+    line = buf;
+  else if ((line = strstr (buf, "\n0::")) != NULL)
+    line++;
+  else
+    return 0;
+
+  line_end = strchr (line, '\n');
+  if (line_end != NULL)
+    *line_end = '\0';
+
+  /* A process in a scope can be moved further into a cgroup below it, as
+   * Fedora's uresourced does with every process of an application. */
+  for (match = strstr (line, unit); match != NULL; match = strstr (match + 1, unit))
+    {
+      if (match > line && match[-1] == '/' && (match[unit_len] == '\0' || match[unit_len] == '/'))
+        return 1;
+    }
+
+  return 0;
+}
+
+static long
+monotonic_ms (void)
+{
+  struct timespec ts;
+
+  if (clock_gettime (CLOCK_MONOTONIC, &ts) != 0)
+    return 0;
+
+  return (long) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void log_message (int priority, const char *format, ...) G_GNUC_PRINTF (2, 3);
+
+/*
+ * log_message:
+ * @priority: syslog priority of the message, such as LOG_ERR
+ * @format: printf() format of the message
+ *
+ * Logs a message. When standard error is connected to the journal, whose
+ * stream gives every line it receives the same priority, the message goes to
+ * the journal through syslog instead, so that it keeps @priority. Otherwise it
+ * goes to standard error.
+ */
+static void
+log_message (int         priority,
+             const char *format,
+             ...)
+{
+  char message[1024];
+  va_list args;
+
+  va_start (args, format);
+  vsnprintf (message, sizeof (message), format, args);
+  va_end (args);
+
+  if (_g_fd_is_journal (STDERR_FILENO))
+    {
+      openlog ("gio-launch-desktop", LOG_PID, LOG_USER);
+      syslog (priority, "%s", message);
+      closelog ();
+    }
+  else
+    {
+      fprintf (stderr, "gio-launch-desktop[%d]: %s\n", getpid (), message);
+    }
+}
+
+/*
+ * wait_for_scope:
+ *
+ * When GDesktopAppInfo asks systemd to create a scope for the application,
+ * it sets GIO_LAUNCH_DESKTOP_SCOPE to the name of the scope without its
+ * trailing "<pid>.scope", and GIO_LAUNCH_DESKTOP_SCOPE_FD to the read end of a
+ * pipe. Waiting until systemd has moved this process into the scope, before
+ * the application is executed, makes the application and every process it
+ * starts belong to the scope from the beginning.
+ *
+ * When systemd refused to create the scope, or the job to start it failed, the
+ * launching process writes the reason to the pipe, which ends the wait. The
+ * end of the pipe without a reason means only that the launching process is
+ * done with the pipe, as systemd is moving the process, or has exited after
+ * sending its request, so the wait continues.
+ *
+ * Either way the application runs. When it runs outside of its scope, which
+ * GLib asks for only where systemd is expected to create it, this is logged
+ * as an error, unless systemd refused because the session ends.
+ *
+ * Both variables are removed, so that the application does not see them.
+ */
+static void
+wait_for_scope (void)
+{
+  const char *prefix;
+  const char *fd_value;
+  const char *application;
+  char unit[NAME_MAX + 1];
+  struct pollfd pfd = { -1, POLLIN, 0 };
+  long deadline;
+  char *end;
+  long fd;
+  int r = -1;
+
+  prefix = getenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  fd_value = getenv ("GIO_LAUNCH_DESKTOP_SCOPE_FD");
+
+  if (fd_value != NULL)
+    {
+      errno = 0;
+      fd = strtol (fd_value, &end, 10);
+      if (errno == 0 && end != fd_value && *end == '\0' && fd > STDERR_FILENO && fd <= INT_MAX)
+        pfd.fd = (int) fd;
+    }
+
+  if (prefix != NULL)
+    r = snprintf (unit, sizeof (unit), "%s%ld.scope", prefix, (long) getpid ());
+
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE_FD");
+
+  if (r < 0 || (size_t) r >= sizeof (unit))
+    {
+      if (pfd.fd >= 0)
+        close (pfd.fd);
+      return;
+    }
+
+  application = getenv ("GIO_LAUNCHED_DESKTOP_FILE");
+  if (application == NULL)
+    application = "the application";
+
+  deadline = monotonic_ms () + SCOPE_TIMEOUT_MS;
+
+  for (;;)
+    {
+      char reason[512];
+      ssize_t n;
+
+      if (is_in_unit (unit))
+        break;
+
+      if (monotonic_ms () >= deadline)
+        {
+          log_message (LOG_ERR, "Scope %s did not exist after %d seconds, running %s outside of it",
+                     unit, SCOPE_TIMEOUT_MS / 1000, application);
+          break;
+        }
+
+      if (pfd.fd < 0)
+        {
+          struct timespec ts = { 0, SCOPE_POLL_MS * 1000000L };
+
+          nanosleep (&ts, NULL);
+          continue;
+        }
+
+      if (poll (&pfd, 1, SCOPE_POLL_MS) <= 0)
+        continue;
+
+      n = read (pfd.fd, reason, sizeof (reason) - 1);
+      if (n > 0)
+        {
+          reason[n] = '\0';
+          /* systemd refuses to start any unit while it is stopping, at the end
+           * of a session, which is expected then and no error. */
+          log_message (strstr (reason, "(org.freedesktop.systemd1.TransactionIsDestructive)") != NULL ? LOG_NOTICE : LOG_ERR,
+                       "systemd did not create scope %s, running %s outside of it: %s",
+                       unit, application, reason);
+          break;
+        }
+
+      if (n < 0 && errno == EINTR)
+        continue;
+
+      close (pfd.fd);
+      pfd.fd = -1;
+    }
+
+  if (pfd.fd >= 0)
+    close (pfd.fd);
+}
+
 #endif
 
 int
@@ -260,6 +495,7 @@ main (int argc, char *argv[])
   putenv (buf);
 
 #if defined(__linux__) && !defined(__ANDROID__)
+  wait_for_scope ();
   set_up_journal (argv[1]);
 #endif
 
