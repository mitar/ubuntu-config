+/* Spawns gio-launch-desktop for a scope which is never created, running a
+ * shell which prints the variables gio-launch-desktop removes.
+ * gio-launch-desktop logs to @error_fd, as standard error is not the
+ * journal. */
+static gboolean
+spawn_launch_desktop_waiting (int  *release_fd,
+                              int  *output_fd,
+                              int  *error_fd,
+                              GPid *pid)
+{
+  const gchar *launch_desktop = g_getenv ("GIO_LAUNCH_DESKTOP");
+  const gchar *argv[] = {
+    NULL, "/bin/sh", "-c",
+    "echo \"${GIO_LAUNCH_DESKTOP_SCOPE-unset} ${GIO_LAUNCH_DESKTOP_SCOPE_FD-unset}\"",
+    NULL
+  };
+  int scope_fds[2];
+  int out_fds[2];
+  int err_fds[2];
+  gchar *fd_str;
+  gchar **envp;
+  GError *error = NULL;
+
+  if (launch_desktop == NULL)
+    {
+      g_test_skip ("GIO_LAUNCH_DESKTOP is not set");
+      return FALSE;
+    }
+  argv[0] = launch_desktop;
+
+  g_unix_open_pipe (scope_fds, O_CLOEXEC, &error);
+  g_assert_no_error (error);
+  g_unix_open_pipe (out_fds, O_CLOEXEC, &error);
+  g_assert_no_error (error);
+  g_unix_open_pipe (err_fds, O_CLOEXEC, &error);
+  g_assert_no_error (error);
+
+  fd_str = g_strdup_printf ("%d", scope_fds[0]);
+  envp = g_get_environ ();
+  envp = g_environ_setenv (envp, "GIO_LAUNCH_DESKTOP_SCOPE", "app-glib-test-never-created-", TRUE);
+  envp = g_environ_setenv (envp, "GIO_LAUNCH_DESKTOP_SCOPE_FD", fd_str, TRUE);
+
+  g_spawn_async_with_pipes_and_fds (NULL, argv, (const gchar * const *) envp,
+                                    G_SPAWN_DO_NOT_REAP_CHILD,
+                                    NULL, NULL,
+                                    -1, out_fds[1], err_fds[1],
+                                    &scope_fds[0], &scope_fds[0], 1,
+                                    pid, NULL, NULL, NULL,
+                                    &error);
+  g_assert_no_error (error);
+
+  g_close (scope_fds[0], NULL);
+  g_close (out_fds[1], NULL);
+  g_close (err_fds[1], NULL);
+  *release_fd = scope_fds[1];
+  *output_fd = out_fds[0];
+  *error_fd = err_fds[0];
+
+  g_strfreev (envp);
+  g_free (fd_str);
+
+  return TRUE;
+}
+
+static gboolean
+output_ready (int fd,
+              int timeout_ms)
+{
+  struct pollfd pfd = { fd, POLLIN, 0 };
+  int r;
+
+  do
+    r = poll (&pfd, 1, timeout_ms);
+  while (r < 0 && errno == EINTR);
+  g_assert_cmpint (r, >=, 0);
+
+  return r > 0;
+}
+
+static void
+test_launch_desktop_scope_refused (void)
+{
+  const gchar *reason = "Refused by the test";
+  int release_fd;
+  int output_fd;
+  int error_fd;
+  GPid pid;
+  gchar buf[100] = { 0 };
+  gchar err[1024] = { 0 };
+  gchar *expected;
+  gssize len;
+  int status;
+
+  g_test_summary ("gio-launch-desktop runs the application without waiting "
+                  "for the scope any more once it is told why the scope will "
+                  "not be created, logs that, and hides the variables from the "
+                  "application");
+
+  if (!spawn_launch_desktop_waiting (&release_fd, &output_fd, &error_fd, &pid))
+    return;
+
+  g_assert_false (output_ready (output_fd, 200));
+
+  g_assert_cmpint (write (release_fd, reason, strlen (reason)), ==, (gssize) strlen (reason));
+  /* Well below the time gio-launch-desktop waits for a scope at most. */
+  g_assert_true (output_ready (output_fd, 2000));
+
+  len = read (output_fd, buf, sizeof (buf) - 1);
+  g_assert_cmpint (len, >, 0);
+  g_assert_cmpstr (buf, ==, "unset unset\n");
+
+  g_assert_cmpint (waitpid (pid, &status, 0), ==, pid);
+  g_assert_true (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+
+  len = read (error_fd, err, sizeof (err) - 1);
+  g_assert_cmpint (len, >, 0);
+  expected = g_strdup_printf ("gio-launch-desktop[%d]: systemd did not create scope "
+                              "app-glib-test-never-created-%d.scope, running the "
+                              "application outside of it: %s\n",
+                              (int) pid, (int) pid, reason);
+  g_assert_cmpstr (err, ==, expected);
+  g_free (expected);
+
+  g_close (release_fd, NULL);
+  g_close (output_fd, NULL);
+  g_close (error_fd, NULL);
+}
+
+static void
+test_launch_desktop_scope_pending (void)
+{
+  int release_fd;
+  int output_fd;
+  int error_fd;
+  GPid pid;
+  int status;
+
+  g_test_summary ("gio-launch-desktop keeps waiting for the scope when the "
+                  "launching process closes the pipe without telling it that "
+                  "the scope will not be created, as it does when it exits "
+                  "after asking for the scope");
+
+  if (!spawn_launch_desktop_waiting (&release_fd, &output_fd, &error_fd, &pid))
+    return;
+
+  g_close (release_fd, NULL);
+  g_assert_false (output_ready (output_fd, 500));
+
+  g_assert_cmpint (kill (pid, SIGKILL), ==, 0);
+  g_assert_cmpint (waitpid (pid, &status, 0), ==, pid);
+  g_close (output_fd, NULL);
+  g_close (error_fd, NULL);
+}
