index 8b0d434..f4ffa22 100644
--- a/gio/gio-launch-desktop.c
+++ b/gio/gio-launch-desktop.c
@@ -40,10 +40,13 @@
 #if defined(__linux__) && !defined(__ANDROID__)
 #include <alloca.h>
 #include <errno.h>
+#include <fcntl.h>
 #include <limits.h>
+#include <poll.h>
 #include <stddef.h>
 #include <string.h>
 #include <syslog.h>
+#include <time.h>
 #include <sys/socket.h>
 #include <sys/un.h>
 
@@ -241,6 +244,161 @@ set_up_journal (const char *argv1)
   close (fd);
 }
 
+/* How long to wait for the scope at most, and how often to check whether this
+ * process is in it already. Waiting ends as soon as it is, so the limit only
+ * matters when the scope is never created. */
+#define SCOPE_TIMEOUT_MS 5000
+#define SCOPE_POLL_MS 1
+
+/*
+ * is_in_unit:
+ * @unit: name of a systemd unit
+ *
+ * Returns: nonzero if this process is in the cgroup of @unit, as listed for
+ *     the unified hierarchy in /proc/self/cgroup
+ */
+static int
+is_in_unit (const char *unit)
+{
+  char buf[4096];
+  const char *line;
+  const char *line_end;
+  size_t unit_len = strlen (unit);
+  size_t line_len;
+  ssize_t len = 0;
+  ssize_t r;
+  int fd;
+
+  fd = open ("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return 0;
+
+  do
+    {
+      r = read (fd, buf + len, sizeof (buf) - 1 - (size_t) len);
+      if (r > 0)
+        len += r;
+    }
+  while ((r > 0 && (size_t) len < sizeof (buf) - 1) || (r < 0 && errno == EINTR));
+  close (fd);
+
+  if (r < 0)
+    return 0;
+
+  buf[len] = '\0';
+
+  if (strncmp (buf, "0::", 3) == 0)
+    line = buf;
+  else if ((line = strstr (buf, "\n0::")) != NULL)
+    line++;
+  else
+    return 0;
+
+  line_end = strchr (line, '\n');
+  line_len = line_end != NULL ? (size_t) (line_end - line) : strlen (line);
+
+  return line_len >= unit_len + 1 &&
+         line[line_len - unit_len - 1] == '/' &&
+         strncmp (line + line_len - unit_len, unit, unit_len) == 0;
+}
+
+static long
+monotonic_ms (void)
+{
+  struct timespec ts;
+
+  if (clock_gettime (CLOCK_MONOTONIC, &ts) != 0)
+    return 0;
+
+  return (long) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/*
+ * wait_for_scope:
+ *
+ * When GDesktopAppInfo asks systemd to create a scope for the application,
+ * it sets GIO_LAUNCH_DESKTOP_SCOPE to the name of the scope without its
+ * trailing "<pid>.scope", and GIO_LAUNCH_DESKTOP_SCOPE_FD to the read end of a
+ * pipe. Waiting until systemd has moved this process into the scope, before
+ * the application is executed, makes the application and every process it
+ * starts belong to the scope from the beginning.
+ *
+ * The launching process writes a byte to the pipe when systemd refused to
+ * create the scope, which ends the wait. The end of the pipe without a byte
+ * means only that the launching process is done with the pipe, or has exited
+ * after sending its request, so the wait continues.
+ *
+ * Both variables are removed, so that the application does not see them.
+ */
+static void
+wait_for_scope (void)
+{
+  const char *prefix;
+  const char *fd_value;
+  char unit[NAME_MAX + 1];
+  struct pollfd pfd = { -1, POLLIN, 0 };
+  long deadline;
+  char *end;
+  long fd;
+  int r = -1;
+
+  prefix = getenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  fd_value = getenv ("GIO_LAUNCH_DESKTOP_SCOPE_FD");
+
+  if (fd_value != NULL)
+    {
+      errno = 0;
+      fd = strtol (fd_value, &end, 10);
+      if (errno == 0 && end != fd_value && *end == '\0' && fd > STDERR_FILENO && fd <= INT_MAX)
+        pfd.fd = (int) fd;
+    }
+
+  if (prefix != NULL)
+    r = snprintf (unit, sizeof (unit), "%s%ld.scope", prefix, (long) getpid ());
+
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE");
+  unsetenv ("GIO_LAUNCH_DESKTOP_SCOPE_FD");
+
+  if (r < 0 || (size_t) r >= sizeof (unit))
+    {
+      if (pfd.fd >= 0)
+        close (pfd.fd);
+      return;
+    }
+
+  deadline = monotonic_ms () + SCOPE_TIMEOUT_MS;
+
+  while (!is_in_unit (unit) && monotonic_ms () < deadline)
+    {
+      char c;
+      ssize_t n;
+
+      if (pfd.fd < 0)
+        {
+          struct timespec ts = { 0, SCOPE_POLL_MS * 1000000L };
+
+          nanosleep (&ts, NULL);
+          continue;
+        }
+
+      if (poll (&pfd, 1, SCOPE_POLL_MS) <= 0)
+        continue;
+
+      n = read (pfd.fd, &c, 1);
+      if (n > 0)
+        break;
+
+      if (n < 0 && errno == EINTR)
+        continue;
+
+      close (pfd.fd);
+      pfd.fd = -1;
+    }
+
+  if (pfd.fd >= 0)
+    close (pfd.fd);
+}
+
 #endif
 
 int
@@ -260,6 +418,7 @@ main (int argc, char *argv[])
   putenv (buf);
 
 #if defined(__linux__) && !defined(__ANDROID__)
+  wait_for_scope ();
   set_up_journal (argv[1]);
 #endif
 
