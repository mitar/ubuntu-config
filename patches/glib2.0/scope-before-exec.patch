+/* A request for the scope of a launched application, which the reply to the
+ * request and the subscription to the job's end each hold a reference to. */
+typedef struct
+{
+  GDBusConnection *connection;  /* (owned) */
+  guint subscription_id;  /* JobRemoved, 0 once unsubscribed */
+  int release_fd;  /* (owned) write end of the pipe gio-launch-desktop waits on, -1 once closed */
+  gchar *unit;  /* (owned) */
+} ScopeRequest;
+
+static void
+scope_request_clear (ScopeRequest *request)
+{
+  g_clear_object (&request->connection);
+  g_free (request->unit);
+}
+
+static void
+scope_request_release (gpointer request)
+{
+  g_rc_box_release_full (request, (GDestroyNotify) scope_request_clear);
+}
+
+/* Ends the request, once its outcome is known, which only the first call
+ * does. When @reason is not %NULL, the scope will not be created, and
+ * gio-launch-desktop is told why, which it logs, and runs the application
+ * outside of it. Otherwise gio-launch-desktop goes on waiting until the
+ * process is in the scope. */
+static void
+scope_request_end (ScopeRequest *request,
+                   const gchar  *reason)
+{
+  if (request->release_fd < 0)
+    return;
+
+  if (reason != NULL)
+    {
+      const gchar *pos;
+      gsize left;
+      ssize_t r;
+
+      g_debug ("Unable to create systemd scope %s: %s", request->unit, reason);
+
+      for (pos = reason, left = strlen (reason); left > 0; pos += r, left -= (gsize) r)
+        {
+          do
+            r = write (request->release_fd, pos, left);
+          while (r < 0 && errno == EINTR);
+
+          if (r <= 0)
+            break;
+        }
+    }
+
+  g_close (request->release_fd, NULL);
+  request->release_fd = -1;
+
+  if (request->subscription_id != 0)
+    {
+      g_dbus_connection_signal_unsubscribe (request->connection, request->subscription_id);
+      request->subscription_id = 0;
+    }
+}
+
+/* Whether this process is managed by the systemd user instance, which is the
+ * one which creates scopes in response to StartTransientUnit on the session
+ * bus. Only the cgroup in the unified hierarchy counts, which is the one
+ * gio-launch-desktop checks for the scope. */
+static gboolean
+is_in_user_manager (void)
+{
+  gchar *contents = NULL;
+  gchar *line;
+  gchar *line_end;
+  gchar *needle;
+  gboolean result;
+
+  if (!g_file_get_contents ("/proc/self/cgroup", &contents, NULL, NULL))
+    return FALSE;
+
+  if (g_str_has_prefix (contents, "0::"))
+    line = contents;
+  else if ((line = strstr (contents, "\n0::")) != NULL)
+    line++;
+  else
+    {
+      g_free (contents);
+      return FALSE;
+    }
+
+  line_end = strchr (line, '\n');
+  if (line_end != NULL)
+    *line_end = '\0';
+
+  needle = g_strdup_printf ("/user@%u.service/", (guint) getuid ());
+  result = strstr (line, needle) != NULL;
+
+  g_free (needle);
+  g_free (contents);
+
+  return result;
+}
+
+/* Whether systemd is on @session_bus, which the bus itself answers, also while
+ * systemd is busy. */
+static gboolean
+has_systemd (GDBusConnection *session_bus)
+{
+  GVariant *reply;
+  gboolean result = FALSE;
+
+  reply = g_dbus_connection_call_sync (session_bus,
+                                       "org.freedesktop.DBus",
+                                       "/org/freedesktop/DBus",
+                                       "org.freedesktop.DBus",
+                                       "NameHasOwner",
+                                       g_variant_new ("(s)", "org.freedesktop.systemd1"),
+                                       G_VARIANT_TYPE ("(b)"),
+                                       G_DBUS_CALL_FLAGS_NONE,
+                                       -1,
+                                       NULL,
+                                       NULL);
+  if (reply != NULL)
+    {
+      g_variant_get (reply, "(b)", &result);
+      g_variant_unref (reply);
+    }
+
+  return result;
+}
+
+/* Escapes @in the way systemd escapes strings for unit names, so that it can
+ * be recovered from the unit name. */
+static gchar *
+escape_unit_name (const gchar *in)
+{
+  GString *str = g_string_sized_new (strlen (in));
+
+  for (; *in != '\0'; in++)
+    {
+      if (g_ascii_isalnum (*in) || *in == ':' || *in == '_' || (*in == '.' && str->len > 0))
+        g_string_append_c (str, *in);
+      else
+        g_string_append_printf (str, "\\x%02x", (guchar) *in);
+    }
+
+  return g_string_free (str, FALSE);
+}
+
+/*
+ * scope_unit_prefix:
+ * @info: the application to launch
+ * @session_bus: (nullable): the session bus
+ *
+ * Determines the systemd scope an application launched by
+ * g_desktop_app_info_launch_uris_with_spawn() is put in.
+ *
+ * The name follows https://systemd.io/DESKTOP_ENVIRONMENTS/ as
+ * app-gnome-<application ID>-<pid>.scope, which is also the name
+ * gnome-desktop's gnome_start_systemd_scope() gives the scope of an
+ * application GNOME launched. When GNOME asks for the scope after GLib, its
+ * request therefore fails without moving any process, instead of moving the
+ * application into a second scope.
+ *
+ * Returns: (transfer full) (nullable): the name of the scope without its
+ *     trailing "<pid>.scope", or %NULL when the application is not put in a
+ *     scope of its own
+ */
+static gchar *
+scope_unit_prefix (GDesktopAppInfo *info,
+                   GDBusConnection *session_bus)
+{
+  const gchar *name;
+  gchar *basename = NULL;
+  gchar *app_id;
+  gchar *escaped;
+  gchar *prefix;
+
+  /* A sandboxed process cannot ask systemd for a scope, and a process outside
+   * of the user instance has none to ask. */
+  if (session_bus == NULL ||
+      glib_get_sandbox_type () != G_SANDBOX_TYPE_UNKNOWN ||
+      !is_in_user_manager ())
+    return NULL;
+
+  /* gio-launch-desktop learns that systemd refused the scope only from a
+   * launching process which still runs when the refusal arrives, and otherwise
+   * waits until its time limit. So no scope is asked for where systemd would
+   * refuse it for certain: on a session bus without systemd, as a bus of its
+   * own which a test runs, or with a name longer than systemd accepts below. */
+  if (!has_systemd (session_bus))
+    return NULL;
+
+  name = g_app_info_get_id (G_APP_INFO (info));
+  if (name == NULL)
+    name = g_app_info_get_executable (G_APP_INFO (info));
+  if (name == NULL || *name == '\0')
+    return NULL;
+
+  if (name[0] == '/')
+    name = basename = g_path_get_basename (name);
+
+  if (g_str_has_suffix (name, ".desktop"))
+    app_id = g_strndup (name, strlen (name) - strlen (".desktop"));
+  else
+    app_id = g_strdup (name);
+
+  escaped = escape_unit_name (app_id);
+  prefix = g_strdup_printf ("app-gnome-%s-", escaped);
+
+  g_free (escaped);
+  g_free (app_id);
+  g_free (basename);
+
+  /* systemd accepts unit names of at most 255 characters, and a PID has at
+   * most 10 digits. */
+  if (strlen (prefix) + 10 + strlen (".scope") > 255)
+    g_clear_pointer (&prefix, g_free);
+
+  return prefix;
+}
+
+static void
+scope_job_removed_cb (GDBusConnection *connection,
+                      const gchar     *sender_name,
+                      const gchar     *object_path,
+                      const gchar     *interface_name,
+                      const gchar     *signal_name,
+                      GVariant        *parameters,
+                      gpointer         user_data)
+{
+  ScopeRequest *request = user_data;
+  const gchar *unit;
+  const gchar *result;
+  gchar *reason;
+
+  if (!g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(uoss)")))
+    return;
+
+  g_variant_get (parameters, "(uo&s&s)", NULL, NULL, &unit, &result);
+  if (g_strcmp0 (unit, request->unit) != 0)
+    return;
+
+  /* systemd moves the process into the scope before the job to start it is
+   * done, so gio-launch-desktop finds it there. With any other result, the
+   * process is not moved. */
+  if (g_str_equal (result, "done"))
+    {
+      scope_request_end (request, NULL);
+      return;
+    }
+
+  reason = g_strdup_printf ("the job starting the scope ended with result %s", result);
+  scope_request_end (request, reason);
+  g_free (reason);
+}
+
+static void
+start_scope_cb (GObject      *source,
+                GAsyncResult *result,
+                gpointer      user_data)
+{
+  ScopeRequest *request = user_data;
+  GVariant *reply;
+  GError *local_error = NULL;
+  gchar *remote_error;
+  gchar *reason;
+
+  reply = g_dbus_connection_call_with_unix_fd_list_finish (G_DBUS_CONNECTION (source), NULL, result, &local_error);
+  if (reply != NULL)
+    {
+      /* systemd queued the job to start the scope, whose end follows as
+       * JobRemoved. */
+      g_variant_unref (reply);
+      scope_request_release (request);
+      return;
+    }
+
+  remote_error = g_dbus_error_get_remote_error (local_error);
+  if (g_strcmp0 (remote_error, "org.freedesktop.systemd1.UnitExists") == 0)
+    {
+      /* Another process asked for the scope first, and systemd moves the
+       * process into it for that request, whose job this process does not
+       * learn the end of. gio-launch-desktop waits for the process to be in
+       * the scope. */
+      scope_request_end (request, NULL);
+    }
+  else
+    {
+      g_dbus_error_strip_remote_error (local_error);
+      if (remote_error != NULL)
+        reason = g_strdup_printf ("%s (%s)", local_error->message, remote_error);
+      else
+        reason = g_strdup_printf ("%s (%s error %d)", local_error->message,
+                                  g_quark_to_string (local_error->domain), local_error->code);
+      scope_request_end (request, reason);
+      g_free (reason);
+    }
+
+  g_free (remote_error);
+  g_error_free (local_error);
+  scope_request_release (request);
+}
+
+/*
+ * start_scope:
+ * @session_bus: the session bus
+ * @unit: name of the scope
+ * @description: description of the scope
+ * @pid: the launched process, gio-launch-desktop, waiting for the scope
+ * @release_fd: (transfer full): write end of the pipe @pid waits on
+ *
+ * Asks systemd to create the scope @unit for @pid. The request has been sent
+ * when this returns. Once systemd refused it, or the job to start the scope
+ * ended with another result than done, the reason is written to @release_fd,
+ * which ends the wait of gio-launch-desktop. Otherwise @release_fd is closed
+ * without a reason, once the job is done or its end cannot be learnt, and
+ * gio-launch-desktop goes on waiting until the process is in the scope.
+ */
+static void
+start_scope (GDBusConnection *session_bus,
+             const gchar     *unit,
+             const gchar     *description,
+             GPid             pid,
+             int              release_fd)
+{
+  GVariantBuilder builder;
+  ScopeRequest *request;
+  guint32 pid_u32 = (guint32) pid;
+  GUnixFDList *fd_list = NULL;
+  int pidfd = -1;
+
+  request = g_rc_box_new0 (ScopeRequest);
+  request->connection = g_object_ref (session_bus);
+  request->release_fd = release_fd;
+  request->unit = g_strdup (unit);
+
+  /* Subscribed before the request is sent, so that the job's end cannot be
+   * missed. systemd sends JobRemoved to the client which asked for the job
+   * without that client subscribing to systemd's signals. */
+  request->subscription_id = g_dbus_connection_signal_subscribe (session_bus,
+                                                                 "org.freedesktop.systemd1",
+                                                                 "org.freedesktop.systemd1.Manager",
+                                                                 "JobRemoved",
+                                                                 "/org/freedesktop/systemd1",
+                                                                 NULL,
+                                                                 G_DBUS_SIGNAL_FLAGS_NONE,
+                                                                 scope_job_removed_cb,
+                                                                 g_rc_box_acquire (request),
+                                                                 scope_request_release);
+
+  /* The name of an application created from a command line can be the file
+   * name of its program, which need not be UTF-8. */
+  if (description == NULL || !g_utf8_validate (description, -1, NULL))
+    description = unit;
+
+  g_variant_builder_init_static (&builder, G_VARIANT_TYPE ("(ssa(sv)a(sa(sv)))"));
+  g_variant_builder_add (&builder, "s", unit);
+  g_variant_builder_add (&builder, "s", "fail");
+
+  g_variant_builder_open (&builder, G_VARIANT_TYPE ("a(sv)"));
+  g_variant_builder_add (&builder, "(sv)", "Description",
+                         g_variant_new_string (description));
+  /* A process ID is resolved by systemd in its own PID namespace, which need
+   * not be the one of this process, like in a sandbox which shares the session
+   * bus. A pidfd names the process wherever it is, and the bus has to be able
+   * to pass it. */
+#ifdef SYS_pidfd_open
+  if (g_dbus_connection_get_capabilities (session_bus) & G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING)
+    pidfd = (int) syscall (SYS_pidfd_open, pid, 0);
+#endif
+  if (pidfd >= 0)
+    {
+      fd_list = g_unix_fd_list_new_from_array (&pidfd, 1);
+      g_variant_builder_add (&builder, "(sv)", "PIDFDs",
+                             g_variant_new_parsed ("[%h]", (gint32) 0));
+    }
+  else
+    {
+      g_variant_builder_add (&builder, "(sv)", "PIDs",
+                             g_variant_new_fixed_array (G_VARIANT_TYPE_UINT32, &pid_u32, 1, sizeof (guint32)));
+    }
+  /* Let systemd remove the scope of an application which failed. */
+  g_variant_builder_add (&builder, "(sv)", "CollectMode",
+                         g_variant_new_string ("inactive-or-failed"));
+  g_variant_builder_close (&builder);
+
+  g_variant_builder_open (&builder, G_VARIANT_TYPE ("a(sa(sv))"));
+  g_variant_builder_close (&builder);
+
+  g_dbus_connection_call_with_unix_fd_list (session_bus,
+                                            "org.freedesktop.systemd1",
+                                            "/org/freedesktop/systemd1",
+                                            "org.freedesktop.systemd1.Manager",
+                                            "StartTransientUnit",
+                                            g_variant_builder_end (&builder),
+                                            G_VARIANT_TYPE ("(o)"),
+                                            G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                            -1,
+                                            fd_list,
+                                            NULL,
+                                            start_scope_cb,
+                                            request);
+  g_clear_object (&fd_list);
+
+  /* gio-launch-desktop waits for the scope even when this process exits right
+   * after launching, so the request has to be on its way by then. */
+  g_dbus_connection_flush_sync (session_bus, NULL, NULL);
+}
