+"""
+Test that the PS extractor fails on a file it cannot read, as happens when the
+file vanishes after it was queued for extraction.
+"""
+
+import os
+import subprocess
+import tempfile
+import unittest as ut
+
+import configuration as cfg
+import fixtures
+
+
+class PsVanishedFileTest(ut.TestCase):
+    def test_vanished_file(self):
+        with tempfile.TemporaryDirectory(prefix="tracker-extract-test-") as tmpdir:
+            env = os.environ.copy()
+            env.update(cfg.test_environment(tmpdir))
+            # A MIME type given on the command line is used without looking
+            # at the file, so the file does not have to exist.
+            result = subprocess.run(
+                [
+                    cfg.TRACKER_EXTRACT_PATH,
+                    "--output-format",
+                    "json-ld",
+                    "--mime",
+                    "application/postscript",
+                    "--file",
+                    os.path.join(tmpdir, "vanished.ps"),
+                ],
+                env=env,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+            )
+
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("Metadata extraction failed", result.stderr)
+        self.assertIn("No such file or directory", result.stderr)
+
+
+if __name__ == "__main__":
+    fixtures.tracker_test_main()
