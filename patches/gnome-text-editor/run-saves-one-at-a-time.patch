 }
 
+void
+editor_session_save_async (EditorSession       *self,
+                           gboolean             shutting_down,
+                           GCancellable        *cancellable,
+                           GAsyncReadyCallback  callback,
+                           gpointer             user_data)
+{
+  g_return_if_fail (EDITOR_IS_SESSION (self));
+  g_return_if_fail (!cancellable || G_IS_CANCELLABLE (cancellable));
+
+  editor_session_queue_save (self, shutting_down, FALSE, cancellable, callback, user_data);
+}
+
+static void
+editor_session_save_completed_cb (EditorSession *self,
+                                  GParamSpec    *pspec,
+                                  GTask         *task)
+{
+  EditorSessionSave *state = g_task_get_task_data (task);
+  GTask *next;
+
+  g_assert (EDITOR_IS_SESSION (self));
+  g_assert (G_IS_TASK (task));
+
+  self->saving = FALSE;
+
+  /* The application quits once a save for shutdown has finished, so the
+   * saves waiting for it are completed without running. They would write
+   * a state which is not marked as shut down, and which has no windows
+   * when the last window was closed, over the one saved for shutdown.
+   */
+  if (state->shutting_down)
+    {
+      while ((next = g_queue_pop_head (&self->pending_saves)))
+        {
+          g_task_return_boolean (next, TRUE);
+          g_object_unref (next);
+        }
+
+      return;
+    }
+
+  if ((next = g_queue_pop_head (&self->pending_saves)))
+    editor_session_run_save (self, next);
+}
+
