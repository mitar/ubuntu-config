+/* Saves the drafts and then writes the state of the session saved with
+ * @owned_task, whose reference is passed to the save.
+ */
+static void
+editor_session_run_save (EditorSession *self,
+                         GTask         *owned_task)
+{
+  g_autoptr(GTask) task = owned_task;
+  g_autofree gchar *drafts_dir = NULL;
+  EditorSessionSave *state = g_task_get_task_data (task);
+
+  g_assert (EDITOR_IS_SESSION (self));
+  g_assert (!self->saving);
+
+  self->saving = TRUE;
+  g_signal_connect_object (task,
+                           "notify::completed",
+                           G_CALLBACK (editor_session_save_completed_cb),
+                           self,
+                           G_CONNECT_SWAPPED);
+
   drafts_dir = g_build_filename (g_get_user_data_dir (), APP_ID, "drafts", NULL);
   g_mkdir_with_parents (drafts_dir, 0750);
 
