+static void
+editor_application_restore_window_cb (GtkApplication *application,
+                                      int             reason,
+                                      GVariant       *state,
+                                      gpointer        user_data)
+{
+  EditorApplication *self = (EditorApplication *)application;
+  const char *window_id = NULL;
+
+  g_assert (EDITOR_IS_APPLICATION (self));
+
+  /* Without a window ID, from a window state Text Editor did not save, no
+   * window is created and GTK drops the state.
+   */
+  if (state == NULL || !g_variant_lookup (state, "window-id", "&s", &window_id))
+    return;
+
+  _editor_session_create_restored_window (self->session, window_id);
+}
