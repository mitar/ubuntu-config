+/*
+ * _editor_session_create_restored_window:
+ * @self: an #EditorSession
+ * @window_id: the window ID saved with the window state GTK restores
+ *
+ * Creates the window GTK asks for when it restores the state of a window, which
+ * has to be added to the application while GTK emits
+ * GtkApplication::restore-window so that GTK can give it the window state to
+ * restore. The window is neither shown nor saved in the session state until the
+ * session restore gives it the pages of the window saved with the same ID.
+ * Restored windows the session restore has no pages for are destroyed by
+ * _editor_session_discard_restored_windows().
+ *
+ * Returns: (transfer none): an #EditorWindow
+ */
+EditorWindow *
+_editor_session_create_restored_window (EditorSession *self,
+                                        const char    *window_id)
+{
+  EditorWindow *window;
+
+  g_return_val_if_fail (EDITOR_IS_SESSION (self), NULL);
+  g_return_val_if_fail (window_id != NULL, NULL);
+
+  window = _editor_session_create_window_no_draft (self);
+  g_free (window->window_id);
+  window->window_id = g_strdup (window_id);
+  window->restore_pending = TRUE;
+
+  return window;
+}
+
+/* Returns the restored window waiting for the pages saved under @window_id, no
+ * longer marked as waiting, or NULL when there is none.
+ */
+static EditorWindow *
+take_restored_window (EditorSession *self,
+                      const char    *window_id)
+{
+  g_assert (EDITOR_IS_SESSION (self));
+  g_assert (window_id != NULL);
+
+  for (guint i = 0; i < self->windows->len; i++)
+    {
+      EditorWindow *window = g_ptr_array_index (self->windows, i);
+
+      if (window->restore_pending && g_strcmp0 (window->window_id, window_id) == 0)
+        {
+          window->restore_pending = FALSE;
+          return window;
+        }
+    }
+
+  return NULL;
+}
+
+/* Returns whether a window of the session is not waiting for its pages. */
+static gboolean
+has_window_not_pending (EditorSession *self)
+{
+  g_assert (EDITOR_IS_SESSION (self));
+
+  for (guint i = 0; i < self->windows->len; i++)
+    {
+      EditorWindow *window = g_ptr_array_index (self->windows, i);
+
+      if (!window->restore_pending)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*
+ * _editor_session_has_restored_windows:
+ * @self: an #EditorSession
+ *
+ * Returns: whether windows created by _editor_session_create_restored_window()
+ *    are still waiting for the session restore to give them their pages
+ */
+gboolean
+_editor_session_has_restored_windows (EditorSession *self)
+{
+  g_return_val_if_fail (EDITOR_IS_SESSION (self), FALSE);
+
+  for (guint i = 0; i < self->windows->len; i++)
+    {
+      EditorWindow *window = g_ptr_array_index (self->windows, i);
+
+      if (window->restore_pending)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*
+ * _editor_session_discard_restored_windows:
+ * @self: an #EditorSession
+ *
+ * Destroys the windows created by _editor_session_create_restored_window()
+ * which the session restore did not give any pages, together with the window
+ * state GTK restored for them. It has to be called once the session has another
+ * window, since GTK keeps the state of the last window of the application to
+ * restore it the next time a window is opened.
+ */
+void
+_editor_session_discard_restored_windows (EditorSession *self)
+{
+  g_return_if_fail (EDITOR_IS_SESSION (self));
+
+  for (guint i = self->windows->len; i > 0; i--)
+    {
+      EditorWindow *window = g_ptr_array_index (self->windows, i - 1);
+
+      if (!window->restore_pending)
+        continue;
+
+      /* Removed from the session first, so that destroying it is not handled as
+       * closing the last window, which saves the session and quits.
+       */
+      g_object_ref (window);
+      g_ptr_array_remove_index (self->windows, i - 1);
+      g_signal_emit (self, signals [WINDOW_REMOVED], 0, window);
+      gtk_window_destroy (GTK_WINDOW (window));
+      g_object_unref (window);
+    }
+}
+
