+static gboolean
+editor_window_save_state_cb (EditorWindow *self,
+                             GVariantDict *dict,
+                             gpointer      user_data)
+{
+  g_assert (EDITOR_IS_WINDOW (self));
+  g_assert (dict != NULL);
+
+  g_variant_dict_insert (dict, "window-id", "s", self->window_id);
+
+  return FALSE;
+}
+
 static void
 editor_window_init (EditorWindow *self)
 {
   self->cancellable = g_cancellable_new ();
+  self->window_id = g_uuid_string_random ();
+
+  /* Stable GTK releases do not have GtkApplicationWindow::save-state, so it is
+   * looked up at runtime, which also lets Text Editor build and run without it.
+   */
+  if (g_signal_lookup ("save-state", GTK_TYPE_APPLICATION_WINDOW) != 0)
+    g_signal_connect (self,
+                      "save-state",
+                      G_CALLBACK (editor_window_save_state_cb),
+                      NULL);
 
   gtk_widget_init_template (GTK_WIDGET (self));
 
