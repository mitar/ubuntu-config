 EditorApplication *
 _editor_application_new (gboolean standalone)
 {
@@ -805,6 +830,27 @@ _editor_application_new (gboolean standalone)
                        NULL);
   self->standalone = !!standalone;
 
+  /* With the save/restore API of GTK, GTK saves the window state of every
+   * window, including the name under which the compositor remembers where the
+   * window was placed, and restores it at the next start with
+   * GtkApplication::restore-window. The pages of the windows stay in the
+   * session state of Text Editor, which links both by the window ID. Stable
+   * GTK releases do not have the API, so it is looked up at runtime, which
+   * also lets Text Editor build and run without it. A standalone instance runs
+   * next to the primary one, so it does not save state, which both would write
+   * to the same file.
+   */
+  if (!standalone &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (self), "support-save") != NULL &&
+      g_signal_lookup ("restore-window", GTK_TYPE_APPLICATION) != 0)
+    {
+      g_object_set (self, "support-save", TRUE, NULL);
+      g_signal_connect (self,
+                        "restore-window",
+                        G_CALLBACK (editor_application_restore_window_cb),
+                        NULL);
+    }
+
   return self;
 }
 
