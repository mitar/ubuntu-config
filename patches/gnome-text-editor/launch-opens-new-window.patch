+static void on_restored_window_after_paint_cb (GdkFrameClock *frame_clock,
+                                               EditorWindow  *window);
+static void on_restored_window_enter_monitor_cb (GdkSurface   *surface,
+                                                 GdkMonitor   *monitor,
+                                                 EditorWindow *window);
+
+static void
+stop_waiting_for_restored_windows (EditorSession *self)
+{
+  if (self->unpainted_windows != NULL)
+    {
+      for (guint i = 0; i < self->unpainted_windows->len; i++)
+        {
+          GtkWidget *window = g_ptr_array_index (self->unpainted_windows, i);
+          GdkFrameClock *frame_clock = gtk_widget_get_frame_clock (window);
+
+          if (frame_clock != NULL)
+            g_signal_handlers_disconnect_by_func (frame_clock, G_CALLBACK (on_restored_window_after_paint_cb), window);
+        }
+    }
+
+  if (self->unshown_windows != NULL)
+    {
+      for (guint i = 0; i < self->unshown_windows->len; i++)
+        {
+          GtkWidget *window = g_ptr_array_index (self->unshown_windows, i);
+          GdkSurface *surface = gtk_native_get_surface (GTK_NATIVE (window));
+
+          if (surface != NULL)
+            g_signal_handlers_disconnect_by_func (surface, G_CALLBACK (on_restored_window_enter_monitor_cb), window);
+        }
+    }
+
+  g_clear_handle_id (&self->present_source, g_source_remove);
+  g_clear_pointer (&self->unpainted_windows, g_ptr_array_unref);
+  g_clear_pointer (&self->unshown_windows, g_ptr_array_unref);
+  self->present_grace = FALSE;
+}
+
+static void
+present_pending_windows (EditorSession *self)
+{
+  g_autoptr(GPtrArray) windows = g_steal_pointer (&self->windows_to_present);
+
+  stop_waiting_for_restored_windows (self);
+
+  if (windows == NULL)
+    return;
+
+  for (guint i = 0; i < windows->len; i++)
+    gtk_window_present (g_ptr_array_index (windows, i));
+}
+
+static gboolean
+present_timeout_cb (gpointer data)
+{
+  EditorSession *self = data;
+
+  self->present_source = 0;
+  present_pending_windows (self);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+maybe_present_pending_windows (EditorSession *self)
+{
+  if (self->unpainted_windows->len > 0)
+    return;
+
+  if (self->unshown_windows->len == 0)
+    {
+      present_pending_windows (self);
+      return;
+    }
+
+  /* Every restored window drew its first frame. Mutter shows one which is on
+   * the current workspace shortly after, while one on another workspace is
+   * not shown and does not receive the focus, so the windows waiting are
+   * presented after a moment even if not every restored window was shown.
+   */
+  if (!self->present_grace)
+    {
+      self->present_grace = TRUE;
+      g_clear_handle_id (&self->present_source, g_source_remove);
+      self->present_source = g_timeout_add (250, present_timeout_cb, self);
+    }
+}
+
+static void
+on_restored_window_after_paint_cb (GdkFrameClock *frame_clock,
+                                   EditorWindow  *window)
+{
+  EditorSession *self = EDITOR_SESSION_DEFAULT;
+
+  g_signal_handlers_disconnect_by_func (frame_clock, G_CALLBACK (on_restored_window_after_paint_cb), window);
+
+  if (self->unpainted_windows != NULL &&
+      g_ptr_array_remove (self->unpainted_windows, window))
+    maybe_present_pending_windows (self);
+}
+
+static void
+on_restored_window_enter_monitor_cb (GdkSurface   *surface,
+                                     GdkMonitor   *monitor,
+                                     EditorWindow *window)
+{
+  EditorSession *self = EDITOR_SESSION_DEFAULT;
+
+  g_signal_handlers_disconnect_by_func (surface, G_CALLBACK (on_restored_window_enter_monitor_cb), window);
+
+  if (self->unshown_windows != NULL &&
+      g_ptr_array_remove (self->unshown_windows, window))
+    maybe_present_pending_windows (self);
+}
+
+/* Presents @window. While the windows of a session restored just now are not
+ * shown yet, it is presented once they are, or after a second at the latest.
+ */
+static void
+present_window (EditorSession *self,
+                GtkWindow     *window)
+{
+  /* Mutter focuses a window it shows when it maps without an activation token,
+   * and it shows a restored window only after it drew its first frame, which
+   * can be after a window shown later. Presented after them, this window has
+   * the focus.
+   */
+  if (self->unpainted_windows == NULL)
+    {
+      gtk_window_present (window);
+      return;
+    }
+
+  if (self->windows_to_present == NULL)
+    self->windows_to_present = g_ptr_array_new_with_free_func (g_object_unref);
+  g_ptr_array_add (self->windows_to_present, g_object_ref (window));
+}
+
+/* Shows @window, restored from the session, without activating it, and waits
+ * with presenting other windows until mutter showed it, see present_window().
+ */
+static void
+show_restored_window (EditorSession *self,
+                      EditorWindow  *window)
+{
+  GdkFrameClock *frame_clock;
+  GdkSurface *surface;
+
+  /* GTK activates the first window it maps with the activation token of the
+   * launch, which belongs to the window opened for the launch.
+   */
+  gtk_window_set_auto_startup_notification (FALSE);
+  gtk_widget_set_visible (GTK_WIDGET (window), TRUE);
+  gtk_window_set_auto_startup_notification (TRUE);
+
+  if (!(frame_clock = gtk_widget_get_frame_clock (GTK_WIDGET (window))) ||
+      !(surface = gtk_native_get_surface (GTK_NATIVE (window))))
+    return;
+
+  if (self->unpainted_windows == NULL)
+    {
+      self->unpainted_windows = g_ptr_array_new_with_free_func (g_object_unref);
+      self->unshown_windows = g_ptr_array_new_with_free_func (g_object_unref);
+      self->present_source = g_timeout_add (1000, present_timeout_cb, self);
+    }
+  g_ptr_array_add (self->unpainted_windows, g_object_ref (window));
+  g_ptr_array_add (self->unshown_windows, g_object_ref (window));
+  g_signal_connect (frame_clock, "after-paint", G_CALLBACK (on_restored_window_after_paint_cb), window);
+  g_signal_connect (surface, "enter-monitor", G_CALLBACK (on_restored_window_enter_monitor_cb), window);
+}
