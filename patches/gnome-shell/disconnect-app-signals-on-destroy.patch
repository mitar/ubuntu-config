Description: Disconnect app signal handlers when their actors are destroyed.
 AppDisplay, SearchResultsView and the date menu's EventsSection and WorldClocksSection connect to the
 installed-changed signal of Shell.AppSystem with connect(), and SearchResultsView to the app-filter-changed signal of
 the parental controls manager. The handlers are never disconnected, so they run on disposed actors when the signal is
 emitted after the actors are gone. At shutdown the layout manager destroys uiGroup, and the time limits manager then
 runs a nested main loop, in which a late installed-changed reaches the destroyed actors and GJS logs "has been
 already disposed" criticals, which fail the closeWithActiveWindows test now and then. The handlers are connected with
 connectObject() now, so they are disconnected with their actors.
Author: Christian Glombek <c.glombek@cosa.systems>
Origin: other, https://gitlab.gnome.org/GNOME/gnome-shell/-/merge_requests/4491
Forwarded: not-needed
Last-Update: 2026-11-06

diff -ru a/js/ui/appDisplay.js b/js/ui/appDisplay.js
--- a/js/ui/appDisplay.js
+++ b/js/ui/appDisplay.js
@@ -1340,9 +1340,9 @@
                 this._overviewHiddenId = Main.overview.connect('hidden', () => this.goToPage(0));
         });
 
-        Shell.AppSystem.get_default().connect('installed-changed', () => {
+        Shell.AppSystem.get_default().connectObject('installed-changed', () => {
             Main.queueDeferredWork(this._redisplayWorkId);
-        });
+        }, this);
         this._folderSettings = new Gio.Settings({schema_id: 'org.gnome.desktop.app-folders'});
         this._ensureDefaultFolders();
         this._folderSettings.connect('changed::folder-children', () => {
