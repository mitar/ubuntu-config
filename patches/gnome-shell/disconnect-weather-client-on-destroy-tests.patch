Description: Test that the weather client's changed after the shell destroyed its actors reaches no weather section.
 Adds the shell test weatherChangedAfterShutdown, which emits changed on the date menu's weather client from a
 shutdown handler connected after the shell's own, once the layout manager destroyed uiGroup. Without
 disconnect-weather-client-on-destroy.patch the handler of the destroyed weather section sets its properties, and the
 critical GJS logs fails the test.
Author: Mitar
Forwarded: no
Last-Update: 2026-11-06

--- a/tests/meson.build
+++ b/tests/meson.build
@@ -97,6 +97,9 @@
     'name': 'installedChangedAfterShutdown',
   },
   {
+    'name': 'weatherChangedAfterShutdown',
+  },
+  {
     'name': 'headlessStart',
     'options': ['--hotplug'],
   },
--- /dev/null
+++ b/tests/shell/weatherChangedAfterShutdown.js
@@ -0,0 +1,17 @@
+import * as Main from 'resource:///org/gnome/shell/ui/main.js';
+import * as Scripting from 'resource:///org/gnome/shell/ui/scripting.js';
+
+// Emits changed on the weather client of the date menu once the shell has destroyed its actors at shutdown, as a
+// weather update which arrives in the nested main loop of the time limits manager does. The client outlives the
+// weather section, so a handler still connected for the destroyed section then logs a critical, which fails the test.
+
+/** Run test. */
+export async function run() {
+    Main.overview.hide();
+    await Scripting.waitLeisure();
+
+    const weatherClient = Main.panel.statusArea.dateMenu._weatherItem._weatherClient;
+
+    // Connected after the shell's own shutdown handlers, so it runs after the layout manager destroyed uiGroup.
+    global.connect('shutdown', () => weatherClient.emit('changed'));
+}
