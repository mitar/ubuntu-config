 export function trySpawn(argv) {
-    let pid;
     let path = argv[0];
 
     if (!path?.includes('/')) {
@@ -133,10 +131,11 @@ export function trySpawn(argv) {
     }
 
     try {
+        // Launched like an application, so that GLib puts the command into a
+        // systemd scope of its own before it runs, and it stays a child of
