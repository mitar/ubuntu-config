diff --git a/src/shell-util.c b/src/shell-util.c
index 17af147..8ba9106 100644
--- a/src/shell-util.c
+++ b/src/shell-util.c
@@ -1018,3 +1018,90 @@ shell_util_spawn_async (const char          *working_directory,
   return shell_util_spawn_async_with_pipes (working_directory, argv, envp,
                                             flags, NULL, NULL, NULL, error);
 }
+
+/* An argument is left unquoted when it needs no quoting, so that the program,
+ * the first argument, is also the executable of the GAppInfo, which names its
+ * scope. */
+static void
+append_shell_word (GString    *command_line,
+                   const char *word)
+{
+  g_autofree char *quoted = NULL;
+  const char *c;
+
+  for (c = word; *c != '\0'; c++)
+    {
+      if (!g_ascii_isalnum (*c) && strchr ("/._-+=:,@", *c) == NULL)
+        break;
+    }
+
+  if (*word != '\0' && *c == '\0')
+    {
+      g_string_append (command_line, word);
+      return;
+    }
+
+  quoted = g_shell_quote (word);
+  g_string_append (command_line, quoted);
+}
+
+static void
+reap_child (GDesktopAppInfo *appinfo,
+            GPid             pid,
+            gpointer         user_data)
+{
+  g_child_watch_add (pid, (GChildWatchFunc) g_spawn_close_pid, NULL);
+}
+
+/**
+ * shell_util_spawn_command_async:
+ * @argv: (array zero-terminated=1): the program to run, and its arguments
+ * @context: (nullable): the launch context, from
+ *     shell_global_create_app_launch_context()
+ * @error: return location for error
+ *
+ * Runs @argv the way an application is launched, through #GDesktopAppInfo,
+ * so that GLib puts it into a systemd scope of its own before it runs, and
+ * every process it starts is in that scope too. Like
+ * shell_util_spawn_async(), it resets the rlimit nofile in the child. The
+ * child stays a child of this process, and is reaped once it exits.
+ *
+ * Returns: %TRUE when the program was started, %FALSE if error is set
+ **/
+gboolean
+shell_util_spawn_command_async (const char * const  *argv,
+                                GAppLaunchContext   *context,
+                                GError             **error)
+{
+  ShellGlobal *shell_global = shell_global_get ();
+  g_autoptr (GString) command_line = g_string_new (NULL);
+  g_autoptr (GAppInfo) info = NULL;
+  size_t i;
+
+  g_return_val_if_fail (argv != NULL && argv[0] != NULL, FALSE);
+
+  for (i = 0; argv[i] != NULL; i++)
+    {
+      if (i > 0)
+        g_string_append_c (command_line, ' ');
+      append_shell_word (command_line, argv[i]);
+    }
+
+  /* The command line becomes the Exec key, in which % starts a field code. */
+  g_string_replace (command_line, "%", "%%", 0);
+
+  info = g_app_info_create_from_commandline (command_line->str, NULL,
+                                             G_APP_INFO_CREATE_NONE, error);
+  if (info == NULL)
+    return FALSE;
+
+  /* The child is not left to GLib, which would spawn it through an
+   * intermediate child, so that it stays a child of this process: polkit
+   * relies on that, see https://bugzilla.redhat.com/show_bug.cgi?id=819275 */
+  return g_desktop_app_info_launch_uris_as_manager (G_DESKTOP_APP_INFO (info), NULL, context,
+                                                    G_SPAWN_SEARCH_PATH | G_SPAWN_DO_NOT_REAP_CHILD,
+                                                    spawn_child_setup,
+                                                    shell_global_get_context (shell_global),
+                                                    reap_child, NULL,
+                                                    error);
+}
