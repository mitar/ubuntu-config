Description: Test that installed-changed after the shell destroyed its actors reaches none of them.
 Adds the shell test installedChangedAfterShutdown, which emits installed-changed of Shell.AppSystem from a shutdown
 handler connected after the shell's own, once the layout manager destroyed uiGroup, as an emission which arrives in
 the nested main loop of the time limits manager does. Without disconnect-app-signals-on-destroy.patch the handler of
 the date menu's events section sets properties of the destroyed section, and the critical GJS logs fails the test.
 The test opens no window, so no client writes to the shader cache while the test's home directory is removed.
Author: Mitar
Forwarded: no
Last-Update: 2026-11-06

--- a/tests/meson.build
+++ b/tests/meson.build
@@ -94,6 +94,9 @@
     'name': 'multiMonitor',
   },
   {
+    'name': 'installedChangedAfterShutdown',
+  },
+  {
     'name': 'headlessStart',
     'options': ['--hotplug'],
   },
--- /dev/null
+++ b/tests/shell/installedChangedAfterShutdown.js
@@ -0,0 +1,17 @@
+import Shell from 'gi://Shell';
+
+import * as Main from 'resource:///org/gnome/shell/ui/main.js';
+import * as Scripting from 'resource:///org/gnome/shell/ui/scripting.js';
+
+// Emits installed-changed once the shell has destroyed its actors at shutdown, as an emission which arrives in the
+// nested main loop of the time limits manager does. A handler still connected for a destroyed actor then logs a
+// critical, which fails the test.
+
+/** Run test. */
+export async function run() {
+    Main.overview.hide();
+    await Scripting.waitLeisure();
+
+    // Connected after the shell's own shutdown handlers, so it runs after the layout manager destroyed uiGroup.
+    global.connect('shutdown', () => Shell.AppSystem.get_default().emit('installed-changed'));
+}
