Description: Restore the session when the new-window action finds no window.
 GNOME Shell starts Ptyxis from the dock and the overview with ActivateAction("new-window") rather than Activate(),
 and Ptyxis restores its session only in activate(), so a terminal started that way always opened a blank window and
 the saved session was never restored. The new-window action now restores the session first when no window is open.
 Upstream commit b4777fd, cherry-picked unchanged.
Author: Eoghan Murray <eoghan@getthere.ie>
Origin: upstream, https://gitlab.gnome.org/chergert/ptyxis/-/commit/b4777fde984597cb06cd1549f63d91eee1b3133d
Bug: https://gitlab.gnome.org/chergert/ptyxis/-/work_items/560
Last-Update: 2026-11-06
diff --git a/src/ptyxis-application.c b/src/ptyxis-application.c
index e06d672..07593df 100644
--- a/src/ptyxis-application.c
+++ b/src/ptyxis-application.c
@@ -1458,10 +1458,29 @@ ptyxis_application_new_window_action (GSimpleAction *action,
 {
   PtyxisApplication *self = user_data;
   PtyxisWindow *window;
+  gboolean has_windows = FALSE;
 
   g_assert (!action || G_IS_SIMPLE_ACTION (action));
   g_assert (PTYXIS_IS_APPLICATION (self));
 
+  for (const GList *windows = gtk_application_get_windows (GTK_APPLICATION (self));
+       windows != NULL;
+       windows = windows->next)
+    {
+      if (PTYXIS_IS_WINDOW (windows->data))
+        {
+          has_windows = TRUE;
+          break;
+        }
+    }
+
+  /* If no windows exist yet, attempt to restore the previous session before
+   * opening a blank window. GNOME Shell sends ActivateAction("new-window")
+   * rather than Activate() when launching Ptyxis from the dock, which
+   * bypasses the activate() vfunc where session restore normally occurs. */
+  if (!has_windows && ptyxis_application_restore (self))
+    return;
+
   window = ptyxis_window_new ();
   gtk_application_add_window (GTK_APPLICATION (self), GTK_WINDOW (window));
   gtk_window_present (GTK_WINDOW (window));
