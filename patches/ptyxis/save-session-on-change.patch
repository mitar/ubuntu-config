-    g_warning ("Failed to save session state: %s", error->message);
+    {
+      g_warning ("Failed to save session state: %s", error->message);
+      g_clear_pointer (&self->written_session, g_bytes_unref);
+    }
+
+  if ((pending = g_steal_pointer (&self->pending_session)))
+    ptyxis_application_write_session (self, pending);
+
+  g_application_release (G_APPLICATION (self));
