+
+static void
+ptyxis_application_write_session (PtyxisApplication *self,
+                                  GBytes            *bytes)
+{
+  g_autoptr(GFile) file = NULL;
+  g_autoptr(GFile) directory = NULL;
+
+  g_assert (PTYXIS_IS_APPLICATION (self));
+  g_assert (bytes != NULL);
+
+  /* Writes run one at a time, as two replacing the same file at once could
+   * finish in either order and leave the older state in place.
+   */
+  if (self->writing_session)
+    {
+      g_clear_pointer (&self->pending_session, g_bytes_unref);
+      self->pending_session = g_bytes_ref (bytes);
+      return;
+    }
+
+  if (self->written_session != NULL && g_bytes_equal (self->written_session, bytes))
+    return;
+
+  g_clear_pointer (&self->written_session, g_bytes_unref);
+  self->written_session = g_bytes_ref (bytes);
+  self->writing_session = TRUE;
+
+  file = get_session_file ();
+  directory = g_file_get_parent (file);
+
+  g_application_hold (G_APPLICATION (self));
+
+  g_file_make_directory_with_parents (directory, NULL, NULL);
+  g_file_replace_contents_bytes_async (file,
+                                       bytes,
+                                       NULL,
+                                       FALSE,
+                                       G_FILE_CREATE_REPLACE_DESTINATION,
+                                       NULL,
+                                       ptyxis_application_write_session_cb,
+                                       g_object_ref (self));
 }
 
