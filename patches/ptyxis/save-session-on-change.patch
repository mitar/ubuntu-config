+static void
+ptyxis_application_save_session_timeout_cb (gpointer user_data)
+{
+  PtyxisApplication *self = user_data;
+
+  g_assert (PTYXIS_IS_APPLICATION (self));
+
+  self->save_session_source = 0;
+
+  /* Until the saved session is restored, saving would replace it with the
+   * windows of this run, such as a single one started for a command.
+   */
+  if (self->session != NULL && !self->has_restored_session)
+    return;
+
+  /* Once the last window is closed the session is already saved with it, and
+   * saving now would replace that with an empty one.
+   */
+  if (!has_session_window (self))
+    return;
+
+  ptyxis_application_save_session (self);
+}
+
+/**
+ * ptyxis_application_queue_save_session:
+ * @self: a #PtyxisApplication
+ *
+ * Saves the session a few seconds later, so that the session state follows
+ * windows and tabs while they change and survives an end of the application
+ * which does not close its windows, such as a crash or the end of the desktop
+ * session. Further calls until then are included in the same save.
+ *
+ * Nothing is saved by a standalone instance, nor while a saved session is
+ * still to be restored, nor once no window is left whose tabs are saved.
+ */
+void
+ptyxis_application_queue_save_session (PtyxisApplication *self)
+{
+  g_return_if_fail (PTYXIS_IS_APPLICATION (self));
+
+  /* A standalone instance runs next to the primary one, and both would write
+   * the same file.
+   */
+  if (is_standalone (self))
+    return;
+
+  if (self->save_session_source != 0)
+    return;
+
+  self->save_session_source = g_timeout_add_seconds_once (SAVE_SESSION_DELAY_SECONDS,
+                                                          ptyxis_application_save_session_timeout_cb,
+                                                          self);
 }
 
