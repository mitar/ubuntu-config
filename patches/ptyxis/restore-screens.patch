+/**
+ * ptyxis_tab_dup_screen_text:
+ * @self: a #PtyxisTab
+ *
+ * Returns the text of the screen of the terminal, which is its last rows, as
+ * plain text without colors and without trailing whitespace. A terminal scrolled
+ * back shows earlier rows, so the screen is then the one it had the last time it
+ * was scrolled to the end.
+ *
+ * Returns: (transfer full) (nullable): the text of the screen, or %NULL when
+ *   it is empty
+ */
+char *
+ptyxis_tab_dup_screen_text (PtyxisTab *self)
+{
+  GtkAdjustment *vadjustment;
+
+  g_return_val_if_fail (PTYXIS_IS_TAB (self), NULL);
+
+  /* vte_terminal_get_text_format() returns the rows shown, which are the
+   * screen while the terminal is scrolled to the end.
+   */
+  vadjustment = gtk_scrollable_get_vadjustment (GTK_SCROLLABLE (self->terminal));
+
+  if (vadjustment == NULL ||
+      gtk_adjustment_get_value (vadjustment) + gtk_adjustment_get_page_size (vadjustment) >=
+      gtk_adjustment_get_upper (vadjustment) - .5)
+    {
+      g_autofree char *text = vte_terminal_get_text_format (VTE_TERMINAL (self->terminal), VTE_FORMAT_TEXT);
+
+      if (text != NULL)
+        g_set_str (&self->screen_text, g_strchomp (text));
+    }
+
+  if (ptyxis_str_empty0 (self->screen_text))
+    return NULL;
+
+  return g_strdup (self->screen_text);
+}
+
+/**
+ * ptyxis_tab_show_previous_screen:
+ * @self: a #PtyxisTab
+ * @text: the screen text saved by ptyxis_tab_dup_screen_text()
+ *
+ * Shows the screen the terminal of the tab had in an earlier run, dimmed, so
+ * that the output of the new run starts below it and stands apart. Call it
+ * before the terminal spawns its process.
+ */
+void
+ptyxis_tab_show_previous_screen (PtyxisTab  *self,
+                                 const char *text)
+{
+  g_autofree char *valid = NULL;
+  g_autoptr(GString) str = NULL;
+
+  g_return_if_fail (PTYXIS_IS_TAB (self));
+  g_return_if_fail (text != NULL);
+
+  valid = g_utf8_make_valid (text, -1);
+  str = g_string_new ("\033[2m");
+
+  for (const char *iter = valid; *iter; iter = g_utf8_next_char (iter))
+    {
+      gunichar ch = g_utf8_get_char (iter);
+
+      /* Control characters would be acted on instead of shown, and the text
+       * saved holds none but line ends, which are fed as a carriage return and
+       * a line feed.
+       */
+      if (ch == '\n')
+        g_string_append (str, "\r\n");
+      else if (ch < 0x20 || (ch >= 0x7f && ch < 0xa0))
+        g_string_append_c (str, ' ');
+      else
+        g_string_append_unichar (str, ch);
+    }
+
+  g_string_append (str, "\033[0m\r\n");
+
+  vte_terminal_feed (VTE_TERMINAL (self->terminal), str->str, str->len);
 }
 
