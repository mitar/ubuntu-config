+ *
+ * Saves the session now. With @keep_screens, the screen of each tab is saved
+ * as well, and shown again when the session is restored. Without it, saved
+ * screens are removed, which is meant for closing the last window: the next
+ * start restores its tabs without the screens they had.
+ */
 void
-ptyxis_application_save_session (PtyxisApplication *self)
+ptyxis_application_save_session (PtyxisApplication *self,
+                                 gboolean           keep_screens)
 {
   g_autoptr(GVariant) state = NULL;
+  g_autoptr(GVariant) screens = NULL;
   g_autoptr(GBytes) bytes = NULL;
 
   g_return_if_fail (PTYXIS_IS_APPLICATION (self));
 
   g_clear_handle_id (&self->save_session_source, g_source_remove);
 
-  if ((state = ptyxis_session_save (self)) &&
+  if ((state = ptyxis_session_save (self, keep_screens ? &screens : NULL)) &&
       (bytes = g_variant_get_data_as_bytes (state)))
     ptyxis_application_write_session (self, bytes);
+
+  /* A standalone instance runs next to the primary one, whose screens these
+   * are.
+   */
+  if (is_standalone (self))
+    return;
+
+  /* No tab with a screen is the same as no screens saved, and the empty
+   * dictionary would serialize to no data at all, which GLib refuses to write.
+   */
+  if (screens != NULL && g_variant_n_children (screens) > 0)
+    {
+      g_autoptr(GBytes) screens_bytes = g_variant_get_data_as_bytes (screens);
+
+      ptyxis_application_write_screens (self, screens_bytes);
+    }
+  else
+    {
+      ptyxis_application_write_screens (self, NULL);
+    }
 }
 
