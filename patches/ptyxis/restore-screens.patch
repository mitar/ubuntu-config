+static void
+ptyxis_application_write_screens_cb (GObject      *object,
+                                     GAsyncResult *result,
+                                     gpointer      user_data)
+{
+  GFile *file = (GFile *)object;
+  g_autoptr(PtyxisApplication) self = user_data;
+  g_autoptr(GError) error = NULL;
+  gboolean success;
+
+  g_assert (G_IS_FILE (file));
+  g_assert (G_IS_ASYNC_RESULT (result));
+  g_assert (PTYXIS_IS_APPLICATION (self));
+
+  self->writing_screens = FALSE;
+
+  if (self->written_screens != NULL)
+    success = g_file_replace_contents_finish (file, result, NULL, &error);
+  else
+    success = g_file_delete_finish (file, result, &error) ||
+              g_error_matches (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND);
+
+  if (!success)
+    {
+      g_warning ("Failed to save the screens of the session: %s", error->message);
+      g_clear_pointer (&self->written_screens, g_bytes_unref);
+      self->screens_removed = FALSE;
+    }
+
+  if (self->has_pending_screens)
+    {
+      g_autoptr(GBytes) pending = g_steal_pointer (&self->pending_screens);
+
+      self->has_pending_screens = FALSE;
+      ptyxis_application_write_screens (self, pending);
+    }
+
+  g_application_release (G_APPLICATION (self));
+}
+
+/* Writes the screens of the tabs, or removes the screens file when @bytes is
+ * NULL.
+ */
+static void
+ptyxis_application_write_screens (PtyxisApplication *self,
+                                  GBytes            *bytes)
+{
+  g_autoptr(GFile) file = NULL;
+
+  g_assert (PTYXIS_IS_APPLICATION (self));
+
+  if (self->writing_screens)
+    {
+      g_clear_pointer (&self->pending_screens, g_bytes_unref);
+      self->pending_screens = bytes != NULL ? g_bytes_ref (bytes) : NULL;
+      self->has_pending_screens = TRUE;
+      return;
+    }
+
+  if (bytes == NULL ? self->screens_removed
+                    : (self->written_screens != NULL && g_bytes_equal (self->written_screens, bytes)))
+    return;
+
+  g_clear_pointer (&self->written_screens, g_bytes_unref);
+  self->written_screens = bytes != NULL ? g_bytes_ref (bytes) : NULL;
+  self->screens_removed = bytes == NULL;
+  self->writing_screens = TRUE;
+
+  file = get_screens_file ();
+
+  g_application_hold (G_APPLICATION (self));
+
+  if (bytes != NULL)
+    {
+      g_autoptr(GFile) directory = g_file_get_parent (file);
+
+      /* Private, as terminals show passwords and other secrets */
+      g_file_make_directory_with_parents (directory, NULL, NULL);
+      g_file_replace_contents_bytes_async (file,
+                                           bytes,
+                                           NULL,
+                                           FALSE,
+                                           G_FILE_CREATE_REPLACE_DESTINATION | G_FILE_CREATE_PRIVATE,
+                                           NULL,
+                                           ptyxis_application_write_screens_cb,
+                                           g_object_ref (self));
+    }
+  else
+    {
+      g_file_delete_async (file,
+                           G_PRIORITY_DEFAULT,
+                           NULL,
+                           ptyxis_application_write_screens_cb,
+                           g_object_ref (self));
+    }
+}
