--- a/src/ptyxis-palette.c
+++ b/src/ptyxis-palette.c
@@ -318,6 +318,11 @@
 
   ptyxis_palette_load_color (path, &face->cursor_fg, key_file, scheme, "CursorForeground", NULL);
 
+  if (!ptyxis_palette_load_color (path, &face->highlight_bg, key_file, scheme, "HighlightBackground", NULL))
+    ptyxis_palette_load_color (path, &face->highlight_bg, key_file, scheme, "Highlight", NULL);
+
+  ptyxis_palette_load_color (path, &face->highlight_fg, key_file, scheme, "HighlightForeground", NULL);
+
   if (FALSE ||
       !ptyxis_palette_load_color (path, &face->foreground, key_file, scheme, "Foreground", error) ||
       !ptyxis_palette_load_color (path, &face->background, key_file, scheme, "Background", error) ||
--- a/src/ptyxis-terminal.c
+++ b/src/ptyxis-terminal.c
@@ -145,6 +145,21 @@
       vte_terminal_set_color_cursor (VTE_TERMINAL (self), NULL);
       vte_terminal_set_color_cursor_foreground (VTE_TERMINAL (self), NULL);
     }
+
+  if (face->highlight_bg.alpha > 0)
+    {
+      vte_terminal_set_color_highlight (VTE_TERMINAL (self), &face->highlight_bg);
+
+      if (face->highlight_fg.alpha)
+        vte_terminal_set_color_highlight_foreground (VTE_TERMINAL (self), &face->highlight_fg);
+      else
+        vte_terminal_set_color_highlight_foreground (VTE_TERMINAL (self), NULL);
+    }
+  else
+    {
+      vte_terminal_set_color_highlight (VTE_TERMINAL (self), NULL);
+      vte_terminal_set_color_highlight_foreground (VTE_TERMINAL (self), NULL);
+    }
 }
 
