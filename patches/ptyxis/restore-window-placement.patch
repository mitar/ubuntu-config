+static void
+ptyxis_application_restore_window_cb (PtyxisApplication *self,
+                                      int                reason,
+                                      GVariant          *state,
+                                      gpointer           user_data)
+{
+  PtyxisWindow *window;
+  const char *window_id = NULL;
+
+  g_assert (PTYXIS_IS_APPLICATION (self));
+
+  /* Without a window ID, from a window state Ptyxis did not save, no window is
+   * created and GTK drops the state.
+   */
+  if (state == NULL || !g_variant_lookup (state, "window-id", "&s", &window_id))
+    return;
+
+  /* GTK gives the window state to the window added to the application while
+   * it emits the signal, and the session restore gives the window its tabs and
+   * shows it later, when the command line is handled.
+   */
+  window = ptyxis_window_new_empty ();
+  ptyxis_window_set_window_id (window, window_id);
+  ptyxis_window_set_restore_pending (window, TRUE);
+}
+
+static void
+ptyxis_application_after_emit (GApplication *application,
+                               GVariant     *platform_data)
+{
+  PtyxisApplication *self = (PtyxisApplication *)application;
+  g_autoptr(GPtrArray) pending = g_ptr_array_new_with_free_func (g_object_unref);
+
+  g_assert (PTYXIS_IS_APPLICATION (self));
+
+  G_APPLICATION_CLASS (ptyxis_application_parent_class)->after_emit (application, platform_data);
+
+  /* Windows created for window state GTK restored which the session restore
+   * did not give tabs, because it did not run or saved none for them, are
+   * destroyed, which also drops their window state.
+   */
+  for (const GList *iter = gtk_application_get_windows (GTK_APPLICATION (self));
+       iter != NULL;
+       iter = iter->next)
+    {
+      if (PTYXIS_IS_WINDOW (iter->data) &&
+          ptyxis_window_get_restore_pending (iter->data))
+        g_ptr_array_add (pending, g_object_ref (iter->data));
+    }
+
+  for (guint i = 0; i < pending->len; i++)
+    gtk_window_destroy (g_ptr_array_index (pending, i));
+}
