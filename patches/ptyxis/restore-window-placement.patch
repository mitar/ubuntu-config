@@ -198,6 +232,9 @@ ptyxis_session_restore (PtyxisApplication *app,
       if (!g_variant_lookup (window, "maximized", "b", &maximized))
         maximized = FALSE;
 
+      if (!g_variant_lookup (window, "window-id", "&s", &window_id))
+        window_id = NULL;
+
       g_variant_iter_init (&tab_iter, tabs);
       while (g_variant_iter_loop (&tab_iter, "@a{sv}", &tab))
         {
@@ -252,8 +289,20 @@ ptyxis_session_restore (PtyxisApplication *app,
           if (the_profile == NULL)
             the_profile = ptyxis_application_dup_default_profile (app);
 
+          /* The window GTK restored with the same ID already has the window
+           * state the compositor placed it with the last time, and otherwise a
+           * new window keeps the ID, so that it is placed from the next run on.
+           */
+          if (the_window == NULL && window_id != NULL)
+            the_window = take_restored_window (app, window_id);
+
           if (the_window == NULL)
-            the_window = ptyxis_window_new_empty ();
+            {
+              the_window = ptyxis_window_new_empty ();
+
+              if (window_id != NULL)
+                ptyxis_window_set_window_id (the_window, window_id);
+            }
 
           the_tab = ptyxis_tab_new (the_profile);
 
