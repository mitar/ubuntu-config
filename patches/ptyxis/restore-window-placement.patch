+static gboolean
+ptyxis_window_save_state_cb (PtyxisWindow *self,
+                             GVariantDict *dict,
+                             gpointer      user_data)
+{
+  g_assert (PTYXIS_IS_WINDOW (self));
+  g_assert (dict != NULL);
+
+  /* Not part of the session, so GTK drops its state when restoring it */
+  if (!self->single_terminal_mode)
+    g_variant_dict_insert (dict, "window-id", "s", self->window_id);
+
+  return FALSE;
+}
+
 static void
 ptyxis_window_init (PtyxisWindow *self)
 {
   g_autoptr(GIcon) default_icon = NULL;
   GtkGestureClick *click;
 
+  self->window_id = g_uuid_string_random ();
+
+  /* Stable GTK releases do not have GtkApplicationWindow::save-state, so it is
+   * looked up at runtime, which also lets Ptyxis build and run without it.
+   */
+  if (g_signal_lookup ("save-state", GTK_TYPE_APPLICATION_WINDOW) != 0)
+    g_signal_connect (self,
+                      "save-state",
+                      G_CALLBACK (ptyxis_window_save_state_cb),
+                      NULL);
+
   self->active_tab_bindings = g_binding_group_new ();
   self->profile_bindings = g_binding_group_new ();
 
@@ -2432,6 +2470,71 @@ ptyxis_window_get_single_terminal_mode (PtyxisWindow *self)
   return self->single_terminal_mode;
 }
 
+/**
+ * ptyxis_window_get_window_id:
+ * @self: a #PtyxisWindow
+ *
+ * Returns: the ID naming the window in the session state and in the window
+ *   state GTK saves
+ */
+const char *
+ptyxis_window_get_window_id (PtyxisWindow *self)
+{
+  g_return_val_if_fail (PTYXIS_IS_WINDOW (self), NULL);
+
+  return self->window_id;
+}
+
+/**
+ * ptyxis_window_set_window_id:
+ * @self: a #PtyxisWindow
+ * @window_id: the ID the window was saved with
+ *
+ * Gives the window the ID it was saved with, so that it is saved under the
+ * same one again.
+ */
+void
+ptyxis_window_set_window_id (PtyxisWindow *self,
+                             const char   *window_id)
+{
+  g_return_if_fail (PTYXIS_IS_WINDOW (self));
+  g_return_if_fail (window_id != NULL);
+
+  g_set_str (&self->window_id, window_id);
+}
+
+/**
+ * ptyxis_window_get_restore_pending:
+ * @self: a #PtyxisWindow
+ *
+ * Returns: whether the window was created for window state GTK restored and
+ *   still waits for the session restore to give it its tabs
+ */
+gboolean
+ptyxis_window_get_restore_pending (PtyxisWindow *self)
+{
+  g_return_val_if_fail (PTYXIS_IS_WINDOW (self), FALSE);
+
+  return self->restore_pending;
+}
+
+/**
+ * ptyxis_window_set_restore_pending:
+ * @self: a #PtyxisWindow
+ * @restore_pending: whether the window waits for its tabs
+ *
+ * Marks a window created for window state GTK restored as waiting for its tabs.
+ * Such a window is not shown, saved in the session nor offered for new tabs.
+ */
+void
+ptyxis_window_set_restore_pending (PtyxisWindow *self,
+                                   gboolean      restore_pending)
+{
+  g_return_if_fail (PTYXIS_IS_WINDOW (self));
+
+  self->restore_pending = !!restore_pending;
+}
+
