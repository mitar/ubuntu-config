   self->shortcuts = ptyxis_shortcuts_new (NULL);
   self->xdg_terminals_list_monitor = g_file_monitor (xdg_terminals_list, 0, NULL, NULL);
 
+  /* With the save/restore API of GTK, GTK saves the window state of every
+   * window, including the name under which the compositor remembers where the
+   * window was placed, and restores it at the next start with
+   * GtkApplication::restore-window. The tabs of the windows stay in the session
+   * state of Ptyxis, which links both by the window ID. Stable GTK releases do
+   * not have the API, so it is looked up at runtime, which also lets Ptyxis
+   * build and run without it. GTK reads GtkApplication:support-save when it
+   * starts up. A standalone instance runs next to the primary one, so it does
+   * not save state, which both would write to the same file.
+   */
+  if (!is_standalone (self) &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (self), "support-save") != NULL &&
+      g_signal_lookup ("restore-window", GTK_TYPE_APPLICATION) != 0)
+    {
+      g_object_set (self, "support-save", TRUE, NULL);
+      g_signal_connect (self,
+                        "restore-window",
+                        G_CALLBACK (ptyxis_application_restore_window_cb),
+                        NULL);
+    }
+
   /* Load the session state so it's available if we need it */
   if ((session_bytes = g_file_load_bytes (session_file, NULL, NULL, NULL)))
     {
@@ -1129,6 +1207,7 @@ ptyxis_application_class_init (PtyxisApplicationClass *klass)
   app_class->startup = ptyxis_application_startup;
   app_class->command_line = ptyxis_application_command_line;
   app_class->open = ptyxis_application_open;
+  app_class->after_emit = ptyxis_application_after_emit;
 
   properties[PROP_CONTAINERS] =
     g_param_spec_object ("containers", NULL, NULL,
@@ -1501,7 +1580,8 @@ ptyxis_application_new_window_action (GSimpleAction *action,
        windows != NULL;
        windows = windows->next)
     {
-      if (PTYXIS_IS_WINDOW (windows->data))
+      if (PTYXIS_IS_WINDOW (windows->data) &&
+          !ptyxis_window_get_restore_pending (windows->data))
         {
           has_windows = TRUE;
           break;
@@ -2289,7 +2369,8 @@ has_session_window (PtyxisApplication *self)
        iter = iter->next)
     {
