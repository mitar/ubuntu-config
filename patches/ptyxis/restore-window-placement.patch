+/* Returns the window created for the window state GTK restored under
+ * @window_id, which has the name under which the compositor remembers where the
+ * window was, no longer marked as waiting for its tabs, or NULL when there is
+ * none.
+ */
+static PtyxisWindow *
+take_restored_window (PtyxisApplication *app,
+                      const char        *window_id)
+{
+  g_assert (PTYXIS_IS_APPLICATION (app));
+  g_assert (window_id != NULL);
+
+  for (const GList *iter = gtk_application_get_windows (GTK_APPLICATION (app));
+       iter != NULL;
+       iter = iter->next)
+    {
+      if (PTYXIS_IS_WINDOW (iter->data) &&
+          ptyxis_window_get_restore_pending (iter->data) &&
+          g_strcmp0 (ptyxis_window_get_window_id (iter->data), window_id) == 0)
+        {
+          ptyxis_window_set_restore_pending (iter->data, FALSE);
+          return iter->data;
+        }
+    }
+
+  return NULL;
+}
