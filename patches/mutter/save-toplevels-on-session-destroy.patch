diff --git a/src/wayland/meta-wayland-xdg-session.c b/src/wayland/meta-wayland-xdg-session.c
index 49d142f..43be798 100644
--- a/src/wayland/meta-wayland-xdg-session.c
+++ b/src/wayland/meta-wayland-xdg-session.c
@@ -61,6 +61,7 @@ struct _MetaWaylandXdgSession
   char *id;
   struct wl_resource *resource;
   GHashTable *toplevels; /* name -> MetaWaylandXdgToplevelSession */
+  gboolean removed;
 };
 
 G_DEFINE_FINAL_TYPE (MetaWaylandXdgSession,
@@ -349,6 +350,7 @@ xdg_session_remove (struct wl_client   *wl_client,
   MetaWaylandXdgSession *session =
     META_WAYLAND_XDG_SESSION (wl_resource_get_user_data (resource));
 
+  session->removed = TRUE;
   g_signal_emit (session, signals[DELETE], 0);
 
   wl_resource_destroy (resource);
@@ -514,6 +516,32 @@ xdg_session_destructor (struct wl_resource *resource)
   GHashTableIter iter;
   gpointer value;
 
+  /* Destroying the session preserves the current state of its toplevels, while a toplevel's state is otherwise
+   * saved only when its window is unmanaged. A client which quits without destroying its windows first has its
+   * objects destroyed in the order of their IDs, and a window whose surface, toplevel and xdg_wm_base all have
+   * higher IDs than the session is unmanaged only after the session is gone. A removed session has been deleted,
+   * and saving would create it again.
+   */
+  if (!session->removed)
+    {
+      g_hash_table_iter_init (&iter, session->toplevels);
+      while (g_hash_table_iter_next (&iter, NULL, &value))
+        {
+          MetaWaylandXdgToplevelSession *toplevel_session = value;
+          MetaWindow *window = NULL;
+
+          if (toplevel_session->surface)
+            window = meta_wayland_surface_get_toplevel_window (toplevel_session->surface);
+
+          if (window)
+            {
+              g_signal_emit (session, signals[SAVE_TOPLEVEL], 0,
+                             META_WAYLAND_XDG_TOPLEVEL (toplevel_session->surface->role),
+                             toplevel_session->name, window);
+            }
+        }
+    }
+
   g_signal_emit (session, signals[DESTROYED], 0);
 
   g_hash_table_iter_init (&iter, session->toplevels);
