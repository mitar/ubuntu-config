+static void
+handle_tap_key (MetaDisplay *display)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  static const struct {
+    ClutterModifierType mask;
+    uint32_t keysym;
+  } modifier_keysyms[] = {
+    { CLUTTER_SHIFT_MASK, XKB_KEY_Shift_L },
+    { CLUTTER_CONTROL_MASK, XKB_KEY_Control_L },
+    { CLUTTER_MOD1_MASK, XKB_KEY_Alt_L },
+    { CLUTTER_META_MASK, XKB_KEY_Meta_L },
+    { CLUTTER_SUPER_MASK, XKB_KEY_Super_L },
+    { CLUTTER_HYPER_MASK, XKB_KEY_Hyper_L },
+  };
+  const char *sends = meta_prefs_get_tap_key_sends ();
+  MetaKeyCombo combo;
+  uint64_t now;
+  int i;
+
+  if (!sends || !meta_parse_accelerator (sends, &combo) || combo.keysym == 0)
+    {
+      meta_topic (META_DEBUG_KEYBINDINGS,
+                  "Nothing to send for tap-key, tap-key-sends is \"%s\"",
+                  sends ? sends : "");
+      return;
+    }
+
+  if (!keys->tap_key_device)
+    {
+      ClutterSeat *seat = meta_backend_get_default_seat (keys->backend);
+
+      keys->tap_key_device =
+        clutter_seat_create_virtual_device (seat, CLUTTER_KEYBOARD_DEVICE);
+    }
+
+  /* The combination is played back as a hand would press it: modifiers down,
+   * the key down and up, and the modifiers up again in reverse order. Going
+   * through a virtual keyboard makes it pass through keybinding processing
+   * like any other input, which is what lets it reach global shortcuts.
+   */
+  now = g_get_monotonic_time ();
+
+  for (i = 0; i < G_N_ELEMENTS (modifier_keysyms); i++)
+    {
+      if (combo.modifiers & modifier_keysyms[i].mask)
+        clutter_virtual_input_device_notify_keyval (keys->tap_key_device, now,
+                                                    modifier_keysyms[i].keysym,
+                                                    CLUTTER_KEY_STATE_PRESSED);
+    }
+
+  clutter_virtual_input_device_notify_keyval (keys->tap_key_device, now,
+                                              combo.keysym,
+                                              CLUTTER_KEY_STATE_PRESSED);
+  clutter_virtual_input_device_notify_keyval (keys->tap_key_device, now,
+                                              combo.keysym,
+                                              CLUTTER_KEY_STATE_RELEASED);
+
+  for (i = G_N_ELEMENTS (modifier_keysyms) - 1; i >= 0; i--)
+    {
+      if (combo.modifiers & modifier_keysyms[i].mask)
+        clutter_virtual_input_device_notify_keyval (keys->tap_key_device, now,
+                                                    modifier_keysyms[i].keysym,
+                                                    CLUTTER_KEY_STATE_RELEASED);
+    }
+}
+
+static gboolean
+process_tap_key (MetaDisplay  *display,
+                 ClutterEvent *event,
+                 MetaWindow   *window)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+
+  /* Like the overlay key, a tap is a shortcut, so it does nothing while the
+   * focused window inhibits shortcuts, such as a virtual machine viewer.
+   */
+  if (display->focus_window && !keys->tap_key_only_pressed)
+    {
+      ClutterInputDevice *source;
+
+      source = clutter_event_get_source_device (event);
+      if (meta_window_shortcuts_inhibited (display->focus_window, source))
+        return FALSE;
+    }
+
+  return process_special_modifier_key (display,
+                                       event,
+                                       window,
+                                       &keys->tap_key_only_pressed,
+                                       &keys->tap_key_resolved_key_combo,
+                                       (GFunc) handle_tap_key);
+}
