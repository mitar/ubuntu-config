 static void
+notify_key (ClutterVirtualInputDevice *virtual_keyboard,
+            uint32_t                   key,
+            ClutterKeyState            key_state)
+{
+  clutter_virtual_input_device_notify_key (virtual_keyboard,
+                                           g_get_monotonic_time (),
+                                           key,
+                                           key_state);
+}
+
+static void
+test_keybinding_tap_key (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterSeat *seat;
+  g_autoptr (GSettings) mutter_settings = NULL;
+  g_autoptr (GSettings) settings = NULL;
+  g_autoptr (ClutterVirtualInputDevice) virtual_keyboard = NULL;
+  gboolean triggered = FALSE;
+  gboolean done = FALSE;
+
+  seat = meta_backend_get_default_seat (backend);
+  virtual_keyboard = clutter_seat_create_virtual_device (seat,
+                                                         CLUTTER_KEYBOARD_DEVICE);
+
+  /* The default overlay key covers both Super keys and would take the tap
+   * before the tap key does, so it is narrowed to the left one.
+   */
+  mutter_settings = g_settings_new ("org.gnome.mutter");
+  g_settings_set_string (mutter_settings, "overlay-key", "Super_L");
+  g_settings_set_string (mutter_settings, "tap-key", "Super_R");
+  g_settings_set_string (mutter_settings, "tap-key-sends", "<Super>t");
+
+  settings = g_settings_new ("org.gnome.mutter.test");
+  meta_display_add_keybinding (display,
+                               "test-binding",
+                               settings,
+                               META_KEY_BINDING_NONE,
+                               test_handler,
+                               &triggered, NULL);
+
+  g_idle_add_full (G_PRIORITY_LOW,
+                   set_true_cb,
+                   &done,
+                   NULL);
+  while (!done)
+    g_main_context_iteration (NULL, TRUE);
+
+  /* Held together with another key, the tap key is an ordinary modifier and
+   * sends nothing.
+   */
+  notify_key (virtual_keyboard, KEY_RIGHTMETA, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  notify_key (virtual_keyboard, KEY_RIGHTMETA, CLUTTER_KEY_STATE_RELEASED);
+
+  meta_flush_input (test_context);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+  g_assert_false (triggered);
+
+  /* Tapped on its own, it sends <Super>t, which triggers the binding. */
+  notify_key (virtual_keyboard, KEY_RIGHTMETA, CLUTTER_KEY_STATE_PRESSED);
+  notify_key (virtual_keyboard, KEY_RIGHTMETA, CLUTTER_KEY_STATE_RELEASED);
+
+  while (!triggered)
+    g_main_context_iteration (NULL, TRUE);
+
+  meta_display_remove_keybinding (display, "test-binding");
+  g_settings_reset (mutter_settings, "overlay-key");
+  g_settings_reset (mutter_settings, "tap-key");
+  g_settings_reset (mutter_settings, "tap-key-sends");
+
+  meta_flush_input (test_context);
+  while (g_main_context_iteration (NULL, FALSE)) {}
+}
