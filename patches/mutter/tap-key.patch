 static gboolean
+tap_key_handler (GVariant *value,
+                 gpointer *result,
+                 gpointer  data)
+{
+  MetaKeyCombo combos[2] = { 0 };
+  const gchar *string_value;
+  int i;
+
+  *result = NULL; /* ignored */
+  string_value = g_variant_get_string (value, NULL);
+
+  if (!string_value || !parse_special_key (string_value, combos))
+    {
+      meta_topic (META_DEBUG_KEYBINDINGS,
+                  "Failed to parse value for tap-key");
+      return FALSE;
+    }
+
+  for (i = 0; i < G_N_ELEMENTS (combos); i++)
+    {
+      combos[i].modifiers = 0;
+
+      if (tap_key_combos[i].keysym != combos[i].keysym ||
+          tap_key_combos[i].keycode != combos[i].keycode)
+        {
+          tap_key_combos[i] = combos[i];
+          queue_changed (META_PREF_KEYBINDINGS);
+        }
+    }
+
+  return TRUE;
+}
