+static MetaWindow *
+find_other_client_window (const char *title,
+                          MetaWindow *other)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  g_autoptr (GList) windows = meta_display_list_all_windows (display);
+  GList *l;
+
+  for (l = windows; l; l = l->next)
+    {
+      MetaWindow *window = l->data;
+
+      if (window != other && g_strcmp0 (meta_window_get_title (window), title) == 0)
+        return window;
+    }
+
+  return NULL;
+}
+
+/* The state of a toplevel has to be stored when it changes, so that it is current also when the compositor ends
+ * without unmanaging the window, as in a crash. A second client restores the session while the first one still has
+ * its window mapped, which replaces the session of the first client and restores the toplevel from what was stored
+ * for it until then, without the window having been unmanaged.
+ */
+static void
+toplevel_sessions_restore_changed (void)
+{
+  MetaSessionManager *session_manager;
+  MetaWaylandTestClient *wayland_test_client1;
+  MetaWaylandTestClient *wayland_test_client2;
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterActor *stage = meta_backend_get_stage (backend);
+  MetaWindow *window1;
+  MetaWindow *window2;
+  MtkRectangle frame_rect;
+  g_autofree char *session_id = NULL;
+
+  session_manager = meta_context_get_session_manager (test_context);
+  g_signal_connect (session_manager, "session-instantiated",
+                    G_CALLBACK (on_session_instantiated), &session_id);
+
+  wayland_test_client1 =
+    meta_wayland_test_client_new (test_context, "xdg-session-management-restore");
+
+  wait_for_sync_point (0);
+  wait_for_paint (stage);
+
+  g_signal_handlers_disconnect_by_func (session_manager,
+                                        on_session_instantiated,
+                                        &session_id);
+  g_assert_nonnull (session_id);
+
+  window1 = find_client_window ("toplevel1");
+  g_assert_nonnull (window1);
+
+  meta_window_move_resize_frame (window1, FALSE, 123, 234, 200, 200);
+  wait_for_paint (stage);
+
+  wayland_test_client2 =
+    meta_wayland_test_client_new_with_args (test_context,
+                                            "xdg-session-management-restore",
+                                            session_id,
+                                            NULL);
+
+  wait_for_sync_point (0);
+
+  window2 = find_other_client_window ("toplevel1", window1);
+  g_assert_nonnull (window2);
+
+  frame_rect = meta_window_config_get_rect (window2->config);
+  g_assert_cmpint (frame_rect.x, ==, 123);
+  g_assert_cmpint (frame_rect.y, ==, 234);
+  g_assert_cmpint (frame_rect.width, ==, 200);
+  g_assert_cmpint (frame_rect.height, ==, 200);
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+  meta_wayland_test_client_finish (wayland_test_client1);
+  meta_wayland_test_client_finish (wayland_test_client2);
+}
+
