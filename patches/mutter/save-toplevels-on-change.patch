+/* The protocol has the state of a toplevel updated whenever it changes, so that it is current also when the session
+ * ends without its windows being unmanaged, as when the compositor crashes or the machine loses power. The session
+ * manager writes the session file a few seconds after the first change, so a burst of changes, such as an
+ * interactive move, costs one write.
+ */
+static void
+on_window_changed (MetaWindow                    *window,
+                   MetaWaylandXdgToplevelSession *toplevel_session)
+{
+  MetaWaylandXdgSession *session = toplevel_session->session;
+
+  if (!session || session->removed || !toplevel_session->surface)
+    return;
+
+  /* A toplevel removed with remove_toplevel is no longer part of the session, and saving it would store it again */
+  if (g_hash_table_lookup (session->toplevels, toplevel_session->name) != toplevel_session)
+    return;
+
+  /* A window not placed yet, or shown on all workspaces, has no workspace whose index could be stored */
+  if (!window->workspace)
+    return;
+
+  g_signal_emit (session, signals[SAVE_TOPLEVEL], 0,
+                 META_WAYLAND_XDG_TOPLEVEL (toplevel_session->surface->role),
+                 toplevel_session->name, window);
+}
+
+static void
+on_window_notify (MetaWindow                    *window,
+                  GParamSpec                    *pspec,
+                  MetaWaylandXdgToplevelSession *toplevel_session)
+{
+  on_window_changed (window, toplevel_session);
+}
+
+static void
+connect_window (MetaWaylandXdgToplevelSession *toplevel_session,
+                MetaWindow                    *window)
+{
+  g_signal_connect (window, "unmanaging",
+                    G_CALLBACK (on_window_unmanaging), toplevel_session);
+
+  /* Everything meta_session_state_save_window() stores: the frame rectangle, the monitor which follows from it, the
+   * maximized, tiled and fullscreen state, whether the window is minimized, and its workspace. Tiling changes the
+   * rectangle, so it is covered by the first two.
+   */
+  g_signal_connect (window, "position-changed",
+                    G_CALLBACK (on_window_changed), toplevel_session);
+  g_signal_connect (window, "size-changed",
+                    G_CALLBACK (on_window_changed), toplevel_session);
+  g_signal_connect (window, "workspace-changed",
+                    G_CALLBACK (on_window_changed), toplevel_session);
+  g_signal_connect (window, "notify::maximized-horizontally",
+                    G_CALLBACK (on_window_notify), toplevel_session);
+  g_signal_connect (window, "notify::maximized-vertically",
+                    G_CALLBACK (on_window_notify), toplevel_session);
+  g_signal_connect (window, "notify::fullscreen",
+                    G_CALLBACK (on_window_notify), toplevel_session);
+  g_signal_connect (window, "notify::minimized",
+                    G_CALLBACK (on_window_notify), toplevel_session);
+}
+
+static void
+disconnect_window (MetaWaylandXdgToplevelSession *toplevel_session,
+                   MetaWindow                    *window)
+{
+  g_signal_handlers_disconnect_by_func (window, on_window_unmanaging, toplevel_session);
+  g_signal_handlers_disconnect_by_func (window, on_window_changed, toplevel_session);
+  g_signal_handlers_disconnect_by_func (window, on_window_notify, toplevel_session);
+}
+
