+  g_test_add_func ("/wayland/toplevel/sessions/restore-changed",
+                   toplevel_sessions_restore_changed);
 #ifdef MUTTER_PRIVILEGED_TEST
   (void)(toplevel_sessions_restore_maximized);
   (void)(toplevel_sessions_restore_tiled);
