--- a/src/properties.hh
+++ b/src/properties.hh
@@ -25,6 +25,7 @@
 #include "cairo-glue.hh"
 #include "cxx-utils.hh"
 
+#include <algorithm>
 #include <cassert>
 #include <cmath> // for std::isfinite
 
@@ -956,6 +957,16 @@ public:
                 }
         }
 
+        // Resets every property except those whose id is in @keep, which keep
+        // their value and are not marked dirty.
+        void reset_all_except(std::initializer_list<int> keep)
+        {
+                for (auto const& info: registry().get_all()) {
+                        if (std::find(keep.begin(), keep.end(), info.id()) == keep.end())
+                                reset(info);
+                }
+        }
+
 }; // class TrackingStore
 
 } // namespace vte::property
