Description: Treat Super as Control inside the terminal.
 Super+C sends an interrupt, which leaves Ctrl+C free for the clipboard copy action of the
 surrounding terminal application. Three things are needed: reading a Super or Hyper modifier as
 Control, stealing keypresses carrying those modifiers so they reach the terminal rather than
 the application, and mapping the bare Super keys onto the bare Control keys.
 .
 The decisions live in src/super-as-control.hh as pure functions so that they can be unit tested
 without a display or a GdkEvent. The tests are added by treat-super-as-control-tests.patch.
 .
 read_modifiers_from_gdk() is declared outside the GTK 3 only guard so that the GTK 4 build
 shares the same modifier handling, since upstream reads the modifier state directly there.
Author: Mitar
Forwarded: not-needed
Last-Update: 2026-09-20
--- a/src/super-as-control.hh
+++ b/src/super-as-control.hh
@@ -0,0 +1,44 @@
+/*
+ * Treating Super as Control inside the terminal.
+ *
+ * Swapping the two lets Super+C send an interrupt while Ctrl+C stays free for the clipboard copy action of the
+ * surrounding terminal application. The decisions are kept here as pure functions rather than inline in the
+ * event handlers, so that they can be unit tested without a display or a GdkEvent.
+ */
+
+#pragma once
+
+#include <gdk/gdk.h>
+#include <gdk/gdkkeysyms.h>
+
+namespace vte::super_as_control {
+
+/* Hyper is included alongside Super because a keyboard layout may map the physical Super key to either. */
+inline constexpr unsigned modifiers = unsigned(GDK_SUPER_MASK) | unsigned(GDK_HYPER_MASK);
+
+inline constexpr bool
+held(unsigned mods) noexcept
+{
+        return (mods & modifiers) != 0;
+}
+
+/* Control is added rather than substituted, so code that still wants to know whether Super itself was held can
+ * see it. Without Super or Hyper the mask is returned untouched. */
+inline constexpr unsigned
+add_control(unsigned mods) noexcept
+{
+        return held(mods) ? (mods | unsigned(GDK_CONTROL_MASK)) : mods;
+}
+
+/* Maps the bare Super keys onto the bare Control keys. Every other key value is returned unchanged. */
+inline constexpr unsigned
+map_keyval(unsigned keyval) noexcept
+{
+        switch (keyval) {
+        case GDK_KEY_Super_L: return GDK_KEY_Control_L;
+        case GDK_KEY_Super_R: return GDK_KEY_Control_R;
+        default:              return keyval;
+        }
+}
+
+} /* namespace vte::super_as_control */
