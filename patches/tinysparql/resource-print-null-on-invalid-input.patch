 static void
+test_resource_print_invalid (void)
+{
+	char *str;
+
+	/* On a precondition failure the print functions return NULL,
+	 * which is safe to free, and not a static string.
+	 */
+	g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL, "*TRACKER_IS_RESOURCE*");
+	str = tracker_resource_print_sparql_update (NULL, NULL, NULL);
+	g_test_assert_expected_messages ();
+	g_assert_null (str);
+
+	G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+	g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL, "*TRACKER_IS_RESOURCE*");
+	str = tracker_resource_print_turtle (NULL, NULL);
+	g_test_assert_expected_messages ();
+	g_assert_null (str);
+
+	g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_CRITICAL, "*TRACKER_IS_RESOURCE*");
+	str = tracker_resource_print_jsonld (NULL, NULL);
+	g_test_assert_expected_messages ();
+	g_assert_null (str);
+	G_GNUC_END_IGNORE_DEPRECATIONS
+}
