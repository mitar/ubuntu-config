diff -ruN a/debian/wasm-cxa-stubs.c b/debian/wasm-cxa-stubs.c
--- /dev/null
+++ b/debian/wasm-cxa-stubs.c
@@ -0,0 +1,61 @@
+/*
+ * Ubuntu's wasm32 libc++ is built with exception support while its libc++abi and compiler-rt are not, so
+ * these C++ runtime functions are referenced but defined nowhere (Launchpad bug 2169046). Firefox builds its
+ * wasm sandboxed libraries without exceptions, so none of them is ever reached in a working program, and each
+ * aborts like libc++ built without exceptions does. The signatures match the real ones, as wasm-ld checks them.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+struct _Unwind_Context;
+
+void *__cxa_allocate_exception(size_t size) {
+  (void)size;
+  abort();
+}
+
+void __cxa_throw(void *exception, void *type_info, void (*destructor)(void *)) {
+  (void)exception;
+  (void)type_info;
+  (void)destructor;
+  abort();
+}
+
+void *__cxa_begin_catch(void *exception) {
+  (void)exception;
+  abort();
+}
+
+void __cxa_rethrow(void) {
+  abort();
+}
+
+uintptr_t _Unwind_GetIP(struct _Unwind_Context *context) {
+  (void)context;
+  abort();
+}
+
+uintptr_t _Unwind_GetLanguageSpecificData(struct _Unwind_Context *context) {
+  (void)context;
+  abort();
+}
+
+uintptr_t _Unwind_GetRegionStart(struct _Unwind_Context *context) {
+  (void)context;
+  abort();
+}
+
+void _Unwind_SetGR(struct _Unwind_Context *context, int index, uintptr_t value) {
+  (void)context;
+  (void)index;
+  (void)value;
+  abort();
+}
+
+void _Unwind_SetIP(struct _Unwind_Context *context, uintptr_t value) {
+  (void)context;
+  (void)value;
+  abort();
+}
