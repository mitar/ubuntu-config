# Installed as /etc/systemd/user/stop-application-scopes.service by configure-gnome-desktop.sh, which overwrites edits
# made there, and enabled for every user.
#
# Chromium, and every Electron application built on it, moves its browser process into a scope of its own,
# app-<name>-<pid>.scope, while its zygotes and GPU process stay in the app-gnome-*.scope GNOME launched it in. When
# these scopes are stopped, the helpers can die before the browser process starts to shut down, and it then crashes
# with "GPU process isn't usable. Goodbye.", or stalls without its renderer until the user service manager is killed
# at shutdown. Every application scope is ordered before this service (app-.scope.d/50-graphical-session.conf), so at
# logout systemd stops them only after this service has stopped. Stopping it runs stop-application-scopes, which
# sends SIGTERM to each browser process alone and waits for it to exit, so that it shuts its helpers down itself. At a
# shutdown, stop-application-scopes-before-shutdown.service stops this service before logind starts the shutdown.
#
# Not needed any more once Chromium keeps its helpers in its own scope: https://issues.chromium.org/issues/580525223

[Unit]
Description=Stop the scopes applications created for themselves before GNOME's application scopes
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/libexec/stop-application-scopes
# Bounds how long GNOME's scopes wait at logout when an application does not exit. The script waits for the browser
# processes for less than this.
TimeoutStopSec=10s

[Install]
WantedBy=graphical-session.target
