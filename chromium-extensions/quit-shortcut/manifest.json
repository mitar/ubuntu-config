{
  "manifest_version": 3,
  "name": "Quit with Ctrl+Q",
  "description": "Quits Chromium with Ctrl+Q and keeps its whole session, through the native messaging host local.chromium_quit.",
  "version": "1.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "commands": {
    "quit": {
      "suggested_key": {"default": "Ctrl+Q"},
      "description": "Quit Chromium"
    }
  }
}
