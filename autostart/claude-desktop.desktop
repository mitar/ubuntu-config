# Installed as ~/.config/autostart/claude-desktop.desktop by configure-gnome-desktop.sh, in place of the entry which
# Claude Desktop writes when its setting to start at login is turned on. It differs from that entry only in starting
# Claude Desktop through wait-for-status-notifier-watcher, so that it shows its tray icon, see the script. Claude
# Desktop counts the setting as on while this file exists, removes it when the setting is turned off, and writes its
# own entry again when the setting is turned on.
[Desktop Entry]
Type=Application
Name=Claude
Exec=/usr/local/libexec/wait-for-status-notifier-watcher /usr/lib/claude-desktop/claude-desktop --startup
X-GNOME-Autostart-enabled=true
